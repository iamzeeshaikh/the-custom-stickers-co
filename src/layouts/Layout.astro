---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.jpg',
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://thecustomstickers.co';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Google truncates around 65 characters. Past that the brand suffix costs us the
// tail of the title, which is the part that differentiates the result, so it is
// dropped rather than the headline. Pages bake the suffix into their own title
// prop, so the trim has to happen here at the render point.
const TITLE_BUDGET = 65;
const BRAND_SUFFIX = ' | The Custom Stickers';
const snippetTitle =
  title.length > TITLE_BUDGET && title.endsWith(BRAND_SUFFIX)
    ? title.slice(0, -BRAND_SUFFIX.length)
    : title;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="google-site-verification" content="yHRvDMTg98eoBNRwG29tYZMRADRNXl-95hJkwiHBrzc" />

  <title>{snippetTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="The Custom Stickers" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Preconnect -->
  <!-- Fonts are self-hosted variable files: no third-party round trip before
       the first paint, and one request per family instead of fourteen. -->
  <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plus-jakarta-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Schema Markup -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://thecustomstickers.co/#organization",
        "name": "The Custom Stickers",
        "url": "https://thecustomstickers.co",
        "logo": {
          "@type": "ImageObject",
          "url": "https://thecustomstickers.co/favicon.svg"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+15033580443",
          "contactType": "customer service",
          "email": "info@thecustomstickers.co"
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "2975 Coburn Hollow Road",
          "addressLocality": "Bloomington",
          "addressRegion": "IL",
          "postalCode": "61701",
          "addressCountry": "US"
        },
        "sameAs": []
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://thecustomstickers.co/#localbusiness",
        "name": "The Custom Stickers",
        "url": "https://thecustomstickers.co",
        "telephone": "+15033580443",
        "email": "info@thecustomstickers.co",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "2975 Coburn Hollow Road",
          "addressLocality": "Bloomington",
          "addressRegion": "IL",
          "postalCode": "61701",
          "addressCountry": "US"
        },
        "priceRange": "$$",
        "openingHours": "Mo-Fr 09:00-18:00",
        "image": "https://thecustomstickers.co/images/og-default.jpg"
      },
      {
        "@type": "WebSite",
        "@id": "https://thecustomstickers.co/#website",
        "url": "https://thecustomstickers.co",
        "name": "The Custom Stickers"
      }
    ]
  }
  </script>

  {schema && <script type="application/ld+json" set:html={schema} />}

  <!-- ZeeOps live chat — replaced Zendesk/Zopim. Conversations land in the
       dashboard at chat.zeeops.dev under the `thecustomstickers` site. -->
  <script is:inline>
    // The chat widget waits for the first interaction (or 6s of idle) so it
    // never competes with the page's own render.
    (function () {
      var loaded = false;
      function load() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://chat.zeeops.dev/widget.js?siteId=thecustomstickers';
        document.head.appendChild(s);
      }
      ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
        window.addEventListener(evt, load, { once: true, passive: true });
      });
      window.addEventListener('load', function () { setTimeout(load, 6000); });
    })();
  </script>

  <style is:global>
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 300 900;
      font-display: swap;
      src: url('/fonts/inter-var-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Plus Jakarta Sans';
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url('/fonts/plus-jakarta-sans-var-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    :root {
      --primary: #F97316;
      --primary-dark: #EA6D00;
      --dark: #111827;
      --accent: #2563EB;
      --light-bg: #F8FAFC;
      --white: #ffffff;
      --gray-100: #F3F4F6;
      --gray-200: #E5E7EB;
      --gray-300: #D1D5DB;
      --gray-500: #6B7280;
      --gray-600: #4B5563;
      --gray-700: #374151;
      --gray-800: #1F2937;
      --success: #10B981;
      --error: #EF4444;
      --font-body: 'Inter', system-ui, sans-serif;
      --font-heading: 'Plus Jakarta Sans', system-ui, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      color: var(--dark);
      background: var(--white);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { text-decoration: none; color: inherit; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }
    ul, ol { list-style: none; }
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading);
      font-weight: 700;
      line-height: 1.2;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--primary);
      color: white;
      padding: 14px 28px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
      box-shadow: 0 8px 25px rgba(249,115,22,0.35);
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: white;
      color: var(--dark);
      padding: 14px 28px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
      border: 2px solid var(--gray-200);
      transition: all 0.2s ease;
    }
    .btn-secondary:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-1px);
    }
    .btn-accent {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--accent);
      color: white;
      padding: 14px 28px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
      transition: all 0.2s ease;
    }
    .btn-accent:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 8px 25px rgba(37,99,235,0.35);
    }
    .section-title {
      font-size: clamp(1.8rem, 3vw, 2.8rem);
      font-weight: 800;
      color: var(--dark);
      margin-bottom: 16px;
    }
    .section-subtitle {
      font-size: 1.1rem;
      color: var(--gray-500);
      max-width: 600px;
    }
    .badge {
      display: inline-block;
      background: rgba(249,115,22,0.1);
      color: var(--primary);
      padding: 4px 14px;
      border-radius: 100px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 2px 20px rgba(0,0,0,0.08);
      overflow: hidden;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 24px 0;
    }
    table th {
      background: var(--primary);
      color: white;
      padding: 12px 16px;
      text-align: left;
      font-weight: 600;
    }
    table td {
      padding: 11px 16px;
      border-bottom: 1px solid var(--gray-200);
    }
    table tr:nth-child(even) td { background: var(--gray-100); }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block;
      font-weight: 500;
      margin-bottom: 6px;
      font-size: 14px;
      color: var(--gray-700);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid var(--gray-200);
      border-radius: 8px;
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--dark);
      transition: border-color 0.2s;
      background: white;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(249,115,22,0.15);
    }
    .form-group textarea { resize: vertical; min-height: 120px; }
    .success-msg {
      background: #d1fae5;
      border: 1px solid #10b981;
      color: #065f46;
      padding: 14px 18px;
      border-radius: 8px;
      font-weight: 500;
      display: none;
    }
    .error-msg {
      background: #fee2e2;
      border: 1px solid #ef4444;
      color: #991b1b;
      padding: 14px 18px;
      border-radius: 8px;
      font-weight: 500;
      display: none;
    }
    @media (max-width: 768px) {
      .container { padding: 0 16px; }
      table { font-size: 14px; }
      table th, table td { padding: 9px 12px; }
    }

    /* --- Mobile safety net --------------------------------------------- */
    /* Grid and flex children shrink to their column instead of pushing the
       page wider than the viewport. */
    .grid > *, [style*="display: grid"] > * { min-width: 0; }

    img, svg, video, iframe, table { max-width: 100%; }
    input, select, textarea, button { max-width: 100%; box-sizing: border-box; }

    @media (max-width: 640px) {
      /* Fields under 16px make iOS zoom the page on focus. */
      input, select, textarea { font-size: 16px; }

      /* Thumb-sized hit areas for the dense link lists. */
      footer a, .breadcrumb a, .sidebar-phone, .sidebar-email { display: inline-block; padding-block: 0.3rem; }

      table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    }
  </style>
</head>
<body>
  <slot name="header" />
  <main>
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>
