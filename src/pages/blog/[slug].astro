---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { blogPosts, getBlogPost } from '../../data/blogPosts';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);
if (!post) return Astro.redirect('/blog/');

const url = `https://thecustomstickers.co/blog/${post.slug}/`;
const related = post.related.map((s) => getBlogPost(s)).filter(Boolean);

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.metaDescription,
  datePublished: post.date,
  dateModified: post.date,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: 'The Custom Stickers' },
  publisher: { '@type': 'Organization', name: 'The Custom Stickers', url: 'https://thecustomstickers.co' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout title={post.metaTitle} description={post.metaDescription} canonical={url}>
  <Header slot="header" />
  <WhatsAppButton />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container" style="padding-top:20px">
    <Breadcrumb items={[{ label: 'Blog', href: '/blog/' }, { label: post.title }]} />
  </div>

  <section class="page-hero">
    <div class="container">
      <div class="badge">{post.badge}</div>
      <h1>{post.title}</h1>
      <p>{post.intro}</p>
      <div class="blog-meta">{dateFmt.format(new Date(post.date))} · {post.readTime}</div>
    </div>
  </section>

  <section class="content-page">
    <div class="container blog-body">
      {post.sections.map((section) => (
        <div class="blog-section">
          <h2>{section.heading}</h2>
          <div class="blog-prose" set:html={section.body} />
          {section.bullets && (
            <ul class="blog-bullets">
              {section.bullets.map((b) => <li set:html={b} />)}
            </ul>
          )}
        </div>
      ))}

      <div class="blog-section">
        <h2>Frequently asked questions</h2>
        <div class="faq-list">
          {post.faq.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mat-cta-box">
        <h2>Ready to order your custom stickers?</h2>
        <p>Free design help, fast turnaround, and premium materials on every order.</p>
        <a href="/get-a-quote/" class="btn-primary">Get a Free Quote</a>
      </div>

      {related.length > 0 && (
        <div class="blog-related">
          <h2>Keep reading</h2>
          <div class="blog-related-grid">
            {related.map((r) => (
              <a href={`/blog/${r!.slug}/`} class="blog-related-card">
                <span class="badge">{r!.badge}</span>
                <span class="blog-related-title">{r!.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .blog-meta { color: var(--gray-600); font-size: 14px; margin-top: 8px; }
  .blog-body { max-width: 760px; }
  .blog-section { margin-bottom: 40px; }
  .blog-section h2 { font-size: 1.6rem; margin-bottom: 14px; color: var(--gray-900, #111); }
  .blog-prose :global(p) { color: var(--gray-700, #374151); line-height: 1.8; margin-bottom: 14px; font-size: 1.02rem; }
  .blog-prose :global(a) { color: var(--primary); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose :global(a:hover) { color: #ea580c; }
  .blog-bullets { margin: 4px 0 8px; padding-left: 22px; }
  .blog-bullets li { color: var(--gray-700, #374151); line-height: 1.7; margin-bottom: 8px; }
  .faq-list { display: grid; gap: 14px; }
  .faq-item { border: 1px solid var(--gray-200, #e5e7eb); border-radius: 14px; padding: 18px 20px; }
  .faq-item h3 { font-size: 1.02rem; margin-bottom: 6px; color: var(--gray-900, #111); }
  .faq-item p { color: var(--gray-600, #4b5563); line-height: 1.7; font-size: 0.97rem; }
  .mat-cta-box { background: linear-gradient(135deg, var(--primary), #ea580c); border-radius: 20px; padding: 40px; text-align: center; color: white; margin: 8px 0 40px; }
  .mat-cta-box h2 { color: white; font-size: 1.6rem; margin-bottom: 10px; }
  .mat-cta-box p { color: rgba(255,255,255,0.85); margin-bottom: 20px; }
  .mat-cta-box .btn-primary { background: white; color: var(--primary); }
  .blog-related h2 { font-size: 1.4rem; margin-bottom: 16px; }
  .blog-related-grid { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  .blog-related-card { display: flex; flex-direction: column; gap: 8px; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 14px; padding: 18px; text-decoration: none; transition: border-color .2s; }
  .blog-related-card:hover { border-color: var(--primary); }
  .blog-related-title { font-weight: 600; color: var(--gray-900, #111); }
  @media (max-width: 640px) { .blog-related-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
