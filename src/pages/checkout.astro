---
/**
 * Checkout for the online order box. No card is taken on the site: the order is
 * emailed to the team and paid by PayPal invoice, bank transfer, or cash on
 * delivery for US and Canadian addresses. Lines live in localStorage; /api/order
 * re-prices every line from src/data/order.ts.
 */
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import {
  PACK_QTY,
  PACK_PRICE,
  MAX_PACKS,
  SHIP_COUNTRIES,
  SHIP_LINE,
  PAYMENT_METHODS,
  COD_COUNTRIES,
  ORDER_CATALOG,
  PRODUCTION_TEXT,
  TRANSIT_US_TEXT,
  TRANSIT_INTL_TEXT,
  RETURNS,
} from '../data/order';

const cfg = JSON.stringify({ catalog: ORDER_CATALOG, pack: PACK_PRICE, qty: PACK_QTY, max: MAX_PACKS, cod: COD_COUNTRIES });
---

<Layout
  title="Checkout | The Custom Stickers"
  description={`Order custom stickers online: ${PACK_QTY} stickers for $${PACK_PRICE.toFixed(2)} with free shipping to the USA, UK, Canada and Australia.`}
  canonical="https://thecustomstickers.co/checkout/"
  noindex={true}
>
  <Header slot="header" />
  <WhatsAppButton />

  <section class="tcs-co">
    <div class="container">
      <h1>Checkout</h1>
      <p class="tcs-co-lede">{SHIP_LINE}. Nothing is printed or charged until you approve a free digital proof of your artwork.</p>

      <form id="tcs-co-form" class="tcs-co-grid" novalidate data-cfg={cfg}>
        <div class="tcs-co-main">
          <fieldset class="tcs-co-set">
            <legend>Your details</legend>
            <div class="tcs-co-two">
              <label class="tcs-co-f tcs-co-wide"><span>Full name *</span><input name="name" autocomplete="name" required maxlength="120" /></label>
              <label class="tcs-co-f"><span>Email *</span><input name="email" type="email" autocomplete="email" required maxlength="180" /></label>
              <label class="tcs-co-f"><span>Phone *</span><input name="phone" type="tel" autocomplete="tel" required maxlength="40" /></label>
              <label class="tcs-co-f tcs-co-wide"><span>Company (optional)</span><input name="company" autocomplete="organization" maxlength="140" /></label>
            </div>
          </fieldset>

          <fieldset class="tcs-co-set">
            <legend>Shipping address</legend>
            <div class="tcs-co-two">
              <label class="tcs-co-f tcs-co-wide"><span>Country *</span>
                <select name="country" id="co-country" autocomplete="country" required>
                  {SHIP_COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}
                </select>
              </label>
              <label class="tcs-co-f tcs-co-wide"><span>Address *</span><input name="address1" autocomplete="address-line1" required maxlength="200" /></label>
              <label class="tcs-co-f tcs-co-wide"><span>Apartment, suite, unit (optional)</span><input name="address2" autocomplete="address-line2" maxlength="200" /></label>
              <label class="tcs-co-f"><span>City *</span><input name="city" autocomplete="address-level2" required maxlength="100" /></label>
              <label class="tcs-co-f"><span>State, province or county</span><input name="region" autocomplete="address-level1" maxlength="60" /></label>
              <label class="tcs-co-f"><span>ZIP or postcode *</span><input name="postal" autocomplete="postal-code" required maxlength="20" /></label>
            </div>
            <p class="tcs-co-small">Shipping somewhere else? <a href="/get-a-quote/">Request a quote</a> and tell us your country.</p>
          </fieldset>

          <fieldset class="tcs-co-set">
            <legend>Payment</legend>
            {PAYMENT_METHODS.map((m, i) => (
              <label class="tcs-co-pay" data-pm={m.id}>
                <input type="radio" name="payment" value={m.id} checked={i === 0} />
                <span><strong>{m.name}</strong><br /><small>{m.detail}</small></span>
              </label>
            ))}
          </fieldset>

          <fieldset class="tcs-co-set">
            <legend>Artwork and notes</legend>
            <label class="tcs-co-f"><span>Logo or artwork file (optional, up to 4 MB)</span><input name="artwork" type="file" accept=".pdf,.ai,.eps,.svg,.png,.jpg,.jpeg,.zip" /></label>
            <label class="tcs-co-f"><span>Notes: size, shape, finish, deadline (optional)</span><textarea name="notes" rows="4" maxlength="3000"></textarea></label>
          </fieldset>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="tcs-co-hp" />
        </div>

        <aside class="tcs-co-side">
          <h2>Your order</h2>
          <table class="tcs-co-lines"><tbody data-lines><tr><td>Your order is empty. <a href="/stickers-and-labels/">Choose stickers</a></td></tr></tbody></table>
          <table class="tcs-co-sum">
            <tr><td>Shipping</td><td class="r tcs-co-free">Free</td></tr>
            <tr><th>Total</th><th class="r" data-grand>$0.00</th></tr>
          </table>
          <p class="tcs-co-small">Printing takes {PRODUCTION_TEXT} after you approve the proof. Delivery takes {TRANSIT_US_TEXT} in the USA and {TRANSIT_INTL_TEXT} to the UK, Canada and Australia. Prices are in US dollars.</p>
          <p class="tcs-co-small">Damaged, defective or misprinted orders reported within {RETURNS.claimDays} days are reprinted or refunded. <a href="/shipping-policy/#returns">Returns policy</a></p>
          <p class="tcs-co-err" data-err role="alert"></p>
          <button type="submit" class="tcs-co-btn" data-place disabled>Place order</button>
          <p class="tcs-co-small">Questions? Call <a href="tel:5034614788">(503) 461-4788</a> or email <a href="mailto:info@thecustomstickers.co">info@thecustomstickers.co</a>.</p>
        </aside>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  type Cfg = { catalog: Record<string, string>; pack: number; qty: number; max: number; cod: string[] };
  const KEY = 'tcs-cart';
  const LOADED = Date.now();
  const form = document.getElementById('tcs-co-form') as HTMLFormElement | null;
  if (form) {
    const C = JSON.parse(form.dataset.cfg || '{}') as Cfg;
    const linesEl = form.querySelector('[data-lines]') as HTMLElement;
    const grandEl = form.querySelector('[data-grand]') as HTMLElement;
    const errEl = form.querySelector('[data-err]') as HTMLElement;
    const btn = form.querySelector('[data-place]') as HTMLButtonElement;
    const money = (n: number) => `$${n.toFixed(2)}`;
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

    let cart: { slug: string; packs: number }[] = [];
    try {
      cart = JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {}
    const q = new URLSearchParams(location.search);
    const add = q.get('add');
    if (add && C.catalog[add]) {
      const packs = Math.min(C.max, Math.max(1, parseInt(q.get('packs') || '1', 10) || 1));
      const hit = cart.find((l) => l.slug === add);
      if (hit) hit.packs = packs;
      else cart.push({ slug: add, packs });
      history.replaceState(null, '', '/checkout/');
    }
    cart = cart.filter((l) => C.catalog[l.slug] && l.packs >= 1 && l.packs <= C.max);
    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(cart));
      } catch {}
    };
    save();

    const render = () => {
      if (!cart.length) {
        linesEl.innerHTML = '<tr><td>Your order is empty. <a href="/stickers-and-labels/">Choose stickers</a></td></tr>';
        grandEl.textContent = money(0);
        btn.disabled = true;
        return;
      }
      let total = 0;
      linesEl.innerHTML = cart
        .map((l, i) => {
          const name = C.catalog[l.slug];
          const sum = l.packs * C.pack;
          total += sum;
          let opts = '';
          for (let n = 1; n <= C.max; n++) opts += `<option value="${n}"${n === l.packs ? ' selected' : ''}>${(n * C.qty).toLocaleString('en-US')} stickers</option>`;
          return `<tr><td><a href="/${esc(l.slug)}/">${esc(name)}</a><br><select data-i="${i}" aria-label="Quantity for ${esc(name)}">${opts}</select> <button type="button" data-rm="${i}" class="tcs-co-rm">Remove</button></td><td class="r">${money(sum)}</td></tr>`;
        })
        .join('');
      grandEl.textContent = money(total);
      btn.disabled = false;
    };
    linesEl.addEventListener('change', (e) => {
      const t = e.target as HTMLSelectElement;
      const i = t.getAttribute('data-i');
      if (i !== null) {
        cart[+i].packs = +t.value;
        save();
        render();
      }
    });
    linesEl.addEventListener('click', (e) => {
      const i = (e.target as HTMLElement).getAttribute('data-rm');
      if (i !== null) {
        cart.splice(+i, 1);
        save();
        render();
      }
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));
    render();

    // Cash on delivery only for US and Canadian addresses: hidden elsewhere.
    const countryEl = form.querySelector('#co-country') as HTMLSelectElement;
    const codBox = form.querySelector('[data-pm="cod"]') as HTMLElement;
    const codRule = () => {
      const ok = C.cod.includes(countryEl.value);
      const r = codBox.querySelector('input') as HTMLInputElement;
      r.disabled = !ok;
      codBox.hidden = !ok;
      if (!ok && r.checked) (form.querySelector('input[name=payment][value=paypal]') as HTMLInputElement).checked = true;
    };
    countryEl.addEventListener('change', codRule);
    codRule();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errEl.textContent = '';
      const bad = [...form.querySelectorAll<HTMLInputElement>('[required]')].filter((el) => {
        const v = el.value.trim();
        const ok = v && (el.type !== 'email' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v));
        if (!ok) el.setAttribute('aria-invalid', 'true');
        return !ok;
      });
      if (bad.length) {
        errEl.textContent = 'Please fill in the highlighted fields.';
        bad[0].focus();
        return;
      }
      const file = (form.elements.namedItem('artwork') as HTMLInputElement).files?.[0];
      if (file && file.size > 4 * 1024 * 1024) {
        errEl.textContent = 'The artwork file is over 4 MB. Place the order without it and email the file to us.';
        return;
      }
      const data = new FormData(form);
      data.append('items', JSON.stringify(cart));
      data.append('ts', String(LOADED));
      btn.disabled = true;
      btn.textContent = 'Placing order…';
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      w.gtag?.('event', 'begin_checkout', { currency: 'USD', value: cart.reduce((s, l) => s + l.packs * C.pack, 0) });
      fetch('/api/order/', { method: 'POST', body: data, headers: { Accept: 'application/json' } })
        .then((r) => r.json().catch(() => ({ ok: false, error: 'Server error' })))
        .then((res) => {
          if (!res.ok) throw new Error(res.error || 'Could not place the order');
          w.gtag?.('event', 'purchase', { transaction_id: res.ref, currency: 'USD', value: res.total });
          try {
            localStorage.removeItem(KEY);
          } catch {}
          location.href = `/order-confirmed/?ref=${encodeURIComponent(res.ref)}&pay=${encodeURIComponent(res.payment)}`;
        })
        .catch((err: Error) => {
          errEl.textContent = `${err.message}. Please try again, or call (503) 461-4788.`;
          btn.disabled = false;
          btn.textContent = 'Place order';
        });
    });
  }
</script>

<style is:global>
  .tcs-co { padding: 40px 0 70px; background: var(--light-bg); }
  .tcs-co h1 { margin: 0 0 8px; color: var(--dark); font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .tcs-co-lede { margin: 0 0 24px; color: var(--gray-600); max-width: 720px; line-height: 1.6; }
  .tcs-co-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .tcs-co-set { margin: 0 0 20px; padding: 18px 20px; background: #fff; border: 1px solid var(--gray-200); border-radius: 14px; }
  .tcs-co-set legend { padding: 0 6px; font-weight: 800; color: var(--dark); }
  .tcs-co-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 16px; }
  .tcs-co-wide { grid-column: 1 / -1; }
  .tcs-co-f { display: grid; gap: 6px; font-size: 14px; font-weight: 600; color: var(--gray-700); margin-bottom: 4px; }
  .tcs-co-f input, .tcs-co-f select, .tcs-co-f textarea { width: 100%; padding: 11px 12px; border: 1px solid var(--gray-300); border-radius: 10px; font: inherit; font-size: 16px; font-weight: 400; color: var(--dark); background: #fff; box-sizing: border-box; }
  .tcs-co-f [aria-invalid='true'] { border-color: #b91c1c; }
  .tcs-co-pay { display: flex; gap: 10px; align-items: flex-start; padding: 10px 0; border-top: 1px solid var(--gray-100); cursor: pointer; color: var(--dark); }
  .tcs-co-pay[hidden] { display: none; }
  .tcs-co-pay small { color: var(--gray-600); line-height: 1.5; font-size: 13px; }
  .tcs-co-pay input { margin-top: 4px; }
  .tcs-co-side { position: sticky; top: 100px; padding: 20px; background: #fff; border: 1px solid var(--gray-200); border-radius: 14px; }
  .tcs-co-side h2 { margin: 0 0 12px; font-size: 1.25rem; color: var(--dark); }
  .tcs-co-lines, .tcs-co-sum { width: 100%; border-collapse: collapse; font-size: 15px; color: var(--dark); }
  .tcs-co-lines td { padding: 10px 0; border-bottom: 1px solid var(--gray-100); vertical-align: top; }
  .tcs-co-lines a { color: var(--dark); font-weight: 600; }
  .tcs-co-lines select { margin-top: 6px; padding: 7px 9px; border: 1px solid var(--gray-300); border-radius: 8px; font: inherit; }
  .tcs-co-rm { background: none; border: 0; color: #b91c1c; cursor: pointer; font-size: 13px; }
  .tcs-co-sum td, .tcs-co-sum th { padding: 8px 0; text-align: left; }
  .tcs-co .r { text-align: right; white-space: nowrap; }
  .tcs-co-free { color: #065f46; font-weight: 700; }
  .tcs-co-small { color: var(--gray-600); font-size: 13px; line-height: 1.55; }
  .tcs-co-small a { color: var(--accent); text-decoration: underline; }
  .tcs-co-err { min-height: 1em; color: #b91c1c; font-size: 14px; }
  .tcs-co-btn { width: 100%; padding: 14px 24px; border: 0; border-radius: 10px; background: var(--primary); color: #fff; font-weight: 800; font-size: 16px; cursor: pointer; }
  .tcs-co-btn:hover:not(:disabled) { background: var(--primary-dark); }
  .tcs-co-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .tcs-co-hp { position: absolute; left: -9999px; }
  @media (max-width: 900px) {
    .tcs-co-grid { grid-template-columns: minmax(0, 1fr); }
    .tcs-co-side { position: static; }
    .tcs-co-two { grid-template-columns: minmax(0, 1fr); }
  }
</style>
