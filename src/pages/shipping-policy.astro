---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Layout
  title="Shipping Policy | The Custom Stickers"
  description="The Custom Stickers shipping and returns policy: free shipping to the USA, UK, Canada and Australia, production and delivery times, tracking, and defective-only returns."
  canonical="https://thecustomstickers.co/shipping-policy/"
>
  <Header slot="header" />
  <WhatsAppButton />
  <div class="container" style="padding-top:20px">
    <Breadcrumb items={[{ label: 'Shipping Policy' }]} />
  </div>
  <section class="page-hero">
    <div class="container">
      <div class="badge">Shipping Policy</div>
      <h1>Shipping &amp; Returns Policy</h1>
      <p>Free shipping to the USA, UK, Canada and Australia. Here's how long printing and delivery take, and what happens if something arrives wrong.</p>
    </div>
  </section>
  <section class="content-page">
    <div class="container content-body-wide">
      <p class="last-updated">Last Updated: October 2026</p>

      <h2>Production Time</h2>
      <p>All orders are custom-produced after artwork approval. Production time begins once you approve your digital proof.</p>
      <table>
        <thead><tr><th>Production Option</th><th>Turnaround Time</th><th>Notes</th></tr></thead>
        <tbody>
          <tr><td>Standard Production</td><td>3–5 business days</td><td>Most orders qualify for standard production</td></tr>
          <tr><td>Rush Production</td><td>1–2 business days</td><td>Available for most products at additional cost</td></tr>
          <tr><td>Super Rush</td><td>Same day / Next day</td><td>Contact us to confirm availability</td></tr>
        </tbody>
      </table>
      <p>Business days are Monday through Friday, excluding US federal holidays.</p>

      <h2>Where We Ship and How Long It Takes</h2>
      <p>Shipping is free on every order to the four countries below. Delivery time starts when your order leaves us, after production.</p>
      <table>
        <thead><tr><th>Destination</th><th>Shipping Cost</th><th>Production</th><th>Delivery After Dispatch</th></tr></thead>
        <tbody>
          <tr><td>United States</td><td>Free</td><td>3–5 business days</td><td>5–7 business days</td></tr>
          <tr><td>United Kingdom</td><td>Free</td><td>3–5 business days</td><td>7–10 business days</td></tr>
          <tr><td>Canada</td><td>Free</td><td>3–5 business days</td><td>7–10 business days</td></tr>
          <tr><td>Australia</td><td>Free</td><td>3–5 business days</td><td>7–10 business days</td></tr>
        </tbody>
      </table>
      <p>US orders go by USPS or UPS Ground. UK, Canadian and Australian orders go by tracked international mail or courier. If you need US stickers sooner, ask about expedited (2–3 business days) or overnight delivery before you order and we'll quote it separately.</p>

      <h2>Shipping Rates</h2>
      <ul class="policy-list">
        <li>Standard shipping is free on all orders to the United States, the United Kingdom, Canada and Australia. There is no minimum order for free shipping.</li>
        <li>Expedited and overnight delivery within the US are optional extras, quoted before you order.</li>
        <li>We don't currently ship online orders to other countries. If you're outside these four, email <a href="mailto:info@thecustomstickers.co">info@thecustomstickers.co</a> and we'll tell you what we can do.</li>
        <li>Prices are in US dollars. For orders delivered outside the United States, any import duties or taxes charged by the destination country are paid by the recipient.</li>
      </ul>

      <h2>Order Tracking</h2>
      <p>Once your order ships, you will receive a tracking number via email. You can track your package directly on the carrier's website. If you have not received a tracking number within your expected production time, contact us immediately.</p>

      <h2>Delivery Address</h2>
      <ul class="policy-list">
        <li>Please ensure your delivery address is accurate and complete before submitting your order</li>
        <li>We are not responsible for orders delivered to incorrect addresses provided by the customer</li>
        <li>Address corrections after printing may result in additional shipping charges</li>
      </ul>

      <h2>Damaged or Lost Shipments</h2>
      <p>If your order arrives damaged or doesn't arrive at all:</p>
      <ol class="policy-list numbered">
        <li>Contact us within 14 days of delivery (or of the expected delivery date, if it never arrived)</li>
        <li>Send photos of the damaged packaging and stickers</li>
        <li>We reprint and reship the order free, or refund it, and we deal with the carrier</li>
      </ol>

      <h2 id="returns">Returns, Reprints &amp; Refunds</h2>
      <p>Every sticker order is printed to your own artwork, so it can't be resold. We don't accept returns for a change of mind, a design change after you approve the proof, or ordering the wrong quantity.</p>
      <p>We stand behind our quality with a 100% satisfaction guarantee, so if an order arrives damaged, defective or misprinted, we put it right:</p>
      <ul class="policy-list">
        <li>Report the problem within 14 days of delivery, with photos and your order number</li>
        <li>This covers stickers damaged in transit, printing or cutting defects, and anything that doesn't match the proof you approved</li>
        <li>We reprint the affected stickers free or refund them, whichever you prefer, and we pay any shipping involved</li>
        <li>Refunds go back the way you paid; cash-on-delivery orders are refunded by PayPal or bank transfer</li>
      </ul>

      <h2>Contact Us</h2>
      <p>For shipping questions, order status, or delivery concerns, contact us at:</p>
      <ul class="policy-list">
        <li>📞 Phone: <a href="tel:5034614788">(503) 461-4788</a></li>
        <li>✉️ Email: <a href="mailto:info@thecustomstickers.co">info@thecustomstickers.co</a></li>
        <li>📍 Address: 2975 Coburn Hollow Road, Bloomington, IL 61701</li>
      </ul>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, var(--dark), var(--gray-800)); padding: 80px 0; color: white; text-align: center; }
  .page-hero .badge { background: rgba(249,115,22,0.2); color: #fb923c; margin-bottom: 16px; }
  .page-hero h1 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); color: white; margin-bottom: 16px; }
  .page-hero p { color: rgba(255,255,255,0.75); max-width: 600px; margin: 0 auto; }
  .content-page { padding: 80px 0; background: var(--light-bg); }
  .content-body-wide { background: white; border-radius: 16px; padding: 48px; box-shadow: 0 4px 24px rgba(0,0,0,0.07); }
  .last-updated { font-size: 13px; color: var(--gray-500); margin-bottom: 32px; }
  .content-body-wide h2 { font-size: 1.3rem; margin: 36px 0 14px; padding-top: 12px; border-top: 1px solid var(--gray-100); }
  .content-body-wide h2:first-of-type { margin-top: 0; border-top: none; padding-top: 0; }
  .content-body-wide p { font-size: 15px; color: var(--gray-600); line-height: 1.75; margin-bottom: 16px; }
  .content-body-wide a { color: var(--accent); text-decoration: underline; }
  .policy-list { list-style: none; margin: 16px 0; }
  .policy-list li { padding: 8px 0 8px 20px; border-bottom: 1px solid var(--gray-100); font-size: 15px; color: var(--gray-700); position: relative; }
  .policy-list li::before { content: '•'; position: absolute; left: 4px; color: var(--primary); font-weight: 700; }
  .policy-list.numbered { counter-reset: c; }
  .policy-list.numbered li { counter-increment: c; }
  .policy-list.numbered li::before { content: counter(c) '.'; font-weight: 700; color: var(--primary); left: 0; }
  @media (max-width: 600px) { .content-body-wide { padding: 24px; } }
</style>
