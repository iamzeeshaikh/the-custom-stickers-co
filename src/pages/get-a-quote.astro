---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Layout
  title="Get a Free Custom Sticker Quote | The Custom Stickers"
  description="Request a free quote for custom stickers, labels, decals, and more. Fast response, competitive pricing, bulk discounts. Get your quote now."
  canonical="https://thecustomstickers.co/get-a-quote/"
>
  <Header slot="header" />
  <WhatsAppButton />

  <div class="container" style="padding-top:20px">
    <Breadcrumb items={[{ label: 'Get a Quote' }]} />
  </div>

  <section class="page-hero">
    <div class="container">
      <div class="badge">Free Quote</div>
      <h1>Get Your Free Custom Sticker Quote</h1>
      <p>Tell us about your project and we'll send a detailed quote within 1 business day. No setup fees, no hidden costs.</p>
    </div>
  </section>

  <section class="quote-page-section">
    <div class="container quote-layout">
      <div class="quote-form-col">
        <h2>Request Your Free Quote</h2>
        <form class="full-quote-form" id="full-quote-form" novalidate>
          <input type="text" name="honeypot" class="honeypot" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="product" value="Custom Quote Request" />

          <div class="prefill-banner" id="prefill-banner" style="display:none">
            ✅ Your customization specs have been pre-filled below. Add your contact details and submit.
          </div>

          <div class="form-section-title">Contact Information</div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="fq-name">Your Name *</label>
              <input type="text" id="fq-name" name="name" required placeholder="John Smith" />
            </div>
            <div class="form-group">
              <label for="fq-company">Company Name</label>
              <input type="text" id="fq-company" name="company" placeholder="Acme Corp" />
            </div>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="fq-email">Email Address *</label>
              <input type="email" id="fq-email" name="email" required placeholder="john@example.com" />
            </div>
            <div class="form-group">
              <label for="fq-phone">Phone Number</label>
              <input type="tel" id="fq-phone" name="phone" placeholder="(503) 555-0100" />
            </div>
          </div>

          <div class="form-section-title">Product Details</div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="fq-product">Product Type *</label>
              <select id="fq-product" name="product_type" required>
                <option value="">Select Product</option>
                <option>Die Cut Stickers</option>
                <option>Vinyl Stickers</option>
                <option>Waterproof Stickers</option>
                <option>Holographic Stickers</option>
                <option>Clear Stickers</option>
                <option>Bumper Stickers</option>
                <option>Packaging Labels</option>
                <option>Promotional Stickers</option>
                <option>Business Stickers</option>
                <option>QR Code Stickers</option>
                <option>Glossy Stickers</option>
                <option>Matte Stickers</option>
                <option>Metallic Stickers</option>
                <option>Other (describe below)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="fq-qty">Quantity *</label>
              <select id="fq-qty" name="quantity" required>
                <option value="">Select Quantity</option>
                <option>50-99</option>
                <option>100-249</option>
                <option>250-499</option>
                <option>500-999</option>
                <option>1,000-2,499</option>
                <option>2,500-4,999</option>
                <option>5,000-9,999</option>
                <option>10,000+</option>
              </select>
            </div>
          </div>
          <div class="form-row-3">
            <div class="form-group">
              <label for="fq-size">Size</label>
              <input type="text" id="fq-size" name="size" placeholder='e.g. 3" x 3"' />
            </div>
            <div class="form-group">
              <label for="fq-shape">Shape</label>
              <select id="fq-shape" name="shape">
                <option>Die Cut (Custom)</option>
                <option>Circle</option>
                <option>Square</option>
                <option>Rectangle</option>
                <option>Oval</option>
                <option>Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="fq-material">Material</label>
              <select id="fq-material" name="material">
                <option>Vinyl (Standard)</option>
                <option>Clear Vinyl</option>
                <option>Holographic</option>
                <option>Metallic</option>
                <option>Paper</option>
                <option>Eco-Friendly</option>
                <option>Not Sure</option>
              </select>
            </div>
          </div>
          <div class="form-row-3">
            <div class="form-group">
              <label for="fq-finish">Finish</label>
              <select id="fq-finish" name="finish">
                <option>Glossy</option>
                <option>Matte</option>
                <option>Soft Touch</option>
                <option>UV Spot</option>
                <option>Transparent</option>
                <option>Not Sure</option>
              </select>
            </div>
            <div class="form-group">
              <label for="fq-lam">Lamination</label>
              <select id="fq-lam" name="lamination">
                <option>Standard</option>
                <option>Heavy Duty</option>
                <option>None</option>
              </select>
            </div>
            <div class="form-group">
              <label for="fq-use">Usage</label>
              <select id="fq-use" name="usage">
                <option>Both Indoor &amp; Outdoor</option>
                <option>Indoor Only</option>
                <option>Outdoor Only</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="fq-deadline">Deadline / Turnaround Needed</label>
            <select id="fq-deadline" name="deadline">
              <option>Standard (3-5 business days)</option>
              <option>Rush (1-2 business days)</option>
              <option>2 weeks</option>
              <option>1 month</option>
              <option>No specific deadline</option>
            </select>
          </div>
          <div class="form-group">
            <label for="fq-msg">Project Description / Additional Notes</label>
            <textarea id="fq-msg" name="message" rows="5" placeholder="Describe your project in detail. Include any special requirements, color preferences, artwork notes, or questions..."></textarea>
          </div>
          <div class="form-group">
            <label for="fq-file">Upload Artwork / Reference Files</label>
            <input type="file" id="fq-file" name="artwork" accept=".jpg,.jpeg,.png,.pdf,.ai,.eps,.svg" />
            <small>Accepted: JPG, PNG, PDF, AI, EPS, SVG (max 10MB). You can also email artwork to info@thecustomstickers.co</small>
          </div>

          <div class="success-msg" id="fq-success">
            ✅ Your quote request has been sent! We'll get back to you within 1 business day with a detailed quote.
          </div>
          <div class="error-msg" id="fq-error">
            ❌ Something went wrong. Please try again or call (503) 358-0443.
          </div>

          <button type="submit" class="btn-primary submit-btn">
            <span id="fq-btn-text">Submit Quote Request →</span>
          </button>
        </form>
      </div>

      <div class="quote-sidebar">
        <div class="sidebar-card">
          <h3>What Happens Next?</h3>
          <ol class="next-steps">
            <li><strong>We Review Your Request</strong><br/>Our team checks your requirements and artwork within 1 business day.</li>
            <li><strong>You Receive a Quote</strong><br/>We send a detailed quote with pricing, materials, and timeline.</li>
            <li><strong>Approve & Pay</strong><br/>Approve the quote and we begin production immediately.</li>
            <li><strong>Print & Ship</strong><br/>Your stickers are printed and shipped to your door.</li>
          </ol>
        </div>
        <div class="sidebar-card">
          <h3>Pricing Factors</h3>
          <ul class="price-factors">
            <li>Quantity (more = lower per-unit cost)</li>
            <li>Size and complexity of shape</li>
            <li>Material selection</li>
            <li>Finish and lamination type</li>
            <li>Turnaround time required</li>
          </ul>
        </div>
        <div class="sidebar-card">
          <h3>Contact Us Directly</h3>
          <p>Prefer to talk? Our team is available Mon–Fri 9am–6pm CT.</p>
          <a href="tel:5033580443" class="btn-primary" style="width:100%;justify-content:center;margin:12px 0 8px;">📞 (503) 358-0443</a>
          <a href="mailto:info@thecustomstickers.co" class="btn-secondary" style="width:100%;justify-content:center;">✉️ Email Us</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  // Pre-fill form from URL params sent by the customization tool
  (function () {
    const params = new URLSearchParams(window.location.search);
    const productName = params.get('product');
    const typeParam   = params.get('Type');
    const sizeParam   = params.get('Size');
    const matParam    = params.get('Material');
    const finishParam = params.get('Finish');
    const qtyParam    = params.get('Quantity');
    const adhesive    = params.get('Adhesive');

    // Only activate when coming from the customization tool
    if (!typeParam && !matParam && !qtyParam) return;

    // Show banner
    const banner = document.getElementById('prefill-banner');
    if (banner) banner.style.display = 'block';

    // Hidden product field
    const hiddenProd = document.querySelector<HTMLInputElement>('[name="product"]');
    if (hiddenProd && productName) hiddenProd.value = productName;

    // Product type dropdown — fuzzy match
    const productSelect = document.getElementById('fq-product') as HTMLSelectElement;
    if (productSelect && productName) {
      const norm = productName.toLowerCase();
      const opts = Array.from(productSelect.options);
      const hit  = opts.find(o =>
        norm.includes(o.text.toLowerCase().replace(' stickers','').replace(' labels','').trim()) ||
        o.text.toLowerCase().includes(norm.split(' ')[0])
      );
      if (hit) productSelect.value = hit.value;
      else productSelect.value = 'Other (describe below)';
    }

    // Size text input
    const sizeInput = document.getElementById('fq-size') as HTMLInputElement;
    if (sizeInput && sizeParam) {
      if      (sizeParam.startsWith('Small'))  sizeInput.value = '1" x 2"';
      else if (sizeParam.startsWith('Medium')) sizeInput.value = '3" x 3"';
      else if (sizeParam.startsWith('Large'))  sizeInput.value = '5" x 5"';
      else if (sizeParam !== 'Custom Size')    sizeInput.value = sizeParam;
    }

    // Material dropdown
    const matSelect = document.getElementById('fq-material') as HTMLSelectElement;
    if (matSelect && matParam) {
      const matMap: Record<string, string> = {
        'White Vinyl':  'Vinyl (Standard)',
        'Clear Vinyl':  'Clear Vinyl',
        'Holographic':  'Holographic',
        'Metallic':     'Metallic',
        'Paper':        'Paper',
        'Eco-Friendly': 'Eco-Friendly',
      };
      if (matMap[matParam]) matSelect.value = matMap[matParam];
    }

    // Finish dropdown
    const finishSelect = document.getElementById('fq-finish') as HTMLSelectElement;
    if (finishSelect && finishParam) {
      finishSelect.value = finishParam; // values match directly
    }

    // Quantity — map exact value to range option
    const qtySelect = document.getElementById('fq-qty') as HTMLSelectElement;
    if (qtySelect && qtyParam) {
      const n = parseInt(qtyParam) || 0;
      if      (n <= 99)   qtySelect.value = '50-99';
      else if (n <= 249)  qtySelect.value = '100-249';
      else if (n <= 499)  qtySelect.value = '250-499';
      else if (n <= 999)  qtySelect.value = '500-999';
      else if (n <= 2499) qtySelect.value = '1,000-2,499';
      else if (n <= 4999) qtySelect.value = '2,500-4,999';
      else                qtySelect.value = '5,000-9,999';
    }

    // Sticker type → shape dropdown
    const shapeSelect = document.getElementById('fq-shape') as HTMLSelectElement;
    if (shapeSelect && typeParam) {
      const shapeMap: Record<string, string> = {
        'Die Cut':           'Die Cut (Custom)',
        'Kiss Cut':          'Die Cut (Custom)',
        'Circle / Oval':     'Circle',
        'Rectangle / Square':'Rectangle',
        'Sheet Stickers':    'Other',
        'Roll Labels':       'Other',
      };
      if (shapeMap[typeParam]) shapeSelect.value = shapeMap[typeParam];
    }

    // Append spec summary to message textarea
    const msgEl = document.getElementById('fq-msg') as HTMLTextAreaElement;
    if (msgEl && !msgEl.value) {
      const lines: string[] = [];
      if (productName) lines.push(`Product: ${productName}`);
      if (typeParam)   lines.push(`Type: ${typeParam}`);
      if (adhesive)    lines.push(`Adhesive: ${adhesive}`);
      if (lines.length) msgEl.value = lines.join('\n') + '\n';
    }

    // Scroll to form smoothly
    const form = document.getElementById('full-quote-form');
    if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  })();
</script>

<style>
  .page-hero { background: linear-gradient(135deg, var(--dark), var(--gray-800)); padding: 80px 0; color: white; text-align: center; }
  .page-hero .badge { background: rgba(249,115,22,0.2); color: #fb923c; margin-bottom: 16px; }
  .page-hero h1 { font-size: clamp(2rem, 4vw, 3rem); color: white; margin-bottom: 16px; }
  .page-hero p { color: rgba(255,255,255,0.75); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }
  .quote-page-section { padding: 80px 0; background: var(--light-bg); }
  .quote-layout { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: start; }
  .quote-form-col h2 { font-size: 1.5rem; margin-bottom: 28px; }
  .full-quote-form { background: white; border-radius: 16px; padding: 36px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
  .form-section-title { font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--gray-500); margin: 24px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--gray-200); }
  .form-section-title:first-child { margin-top: 0; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  .submit-btn { width: 100%; justify-content: center; margin-top: 8px; font-size: 16px; padding: 16px; }
  .honeypot { position: absolute; left: -9999px; opacity: 0; width: 1px; }
  small { display: block; color: var(--gray-500); font-size: 12px; margin-top: 4px; }
  .sidebar-card { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.07); margin-bottom: 20px; }
  .sidebar-card h3 { font-size: 1rem; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--gray-100); }
  .next-steps { list-style: none; counter-reset: step; }
  .next-steps li { counter-increment: step; padding: 10px 0 10px 36px; border-bottom: 1px solid var(--gray-100); font-size: 14px; color: var(--gray-600); position: relative; line-height: 1.5; }
  .next-steps li::before { content: counter(step); position: absolute; left: 0; top: 10px; width: 24px; height: 24px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
  .next-steps li strong { display: block; color: var(--dark); font-size: 13px; margin-bottom: 2px; }
  .price-factors { list-style: none; }
  .price-factors li { padding: 8px 0 8px 20px; border-bottom: 1px solid var(--gray-100); font-size: 14px; color: var(--gray-700); position: relative; }
  .price-factors li::before { content: '→'; position: absolute; left: 0; color: var(--primary); font-weight: 600; }
  .sidebar-card p { font-size: 14px; color: var(--gray-600); margin-bottom: 8px; }
  .prefill-banner { background: #d1fae5; border: 1px solid #10b981; color: #065f46; padding: 12px 16px; border-radius: 8px; font-size: 14px; font-weight: 500; margin-bottom: 20px; }
  @media (max-width: 1024px) { .quote-layout { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .form-row-2, .form-row-3 { grid-template-columns: minmax(0, 1fr); } .full-quote-form { padding: 20px; } }
</style>

<script>
  const form = document.getElementById('full-quote-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const honey = form.querySelector<HTMLInputElement>('[name="honeypot"]');
    if (honey?.value) return;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnText = document.getElementById('fq-btn-text') as HTMLElement;
    const success = document.getElementById('fq-success') as HTMLElement;
    const error = document.getElementById('fq-error') as HTMLElement;
    btn.disabled = true;
    btnText.textContent = 'Sending...';
    success.style.display = 'none';
    error.style.display = 'none';
    try {
      const data = new FormData(form);
      const res = await fetch('/api/submit-form/', { method: 'POST', body: data });
      if (res.ok) { form.reset(); window.location.href = '/thank-you/'; return; }
      else { error.style.display = 'block'; }
    } catch { error.style.display = 'block'; }
    finally { btn.disabled = false; btnText.textContent = 'Submit Quote Request →'; }
  });
</script>
