---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Layout
  title="Privacy Policy | The Custom Stickers"
  description="Read the privacy policy of The Custom Stickers. Learn how we collect, use, and protect your personal information when you use our website and services."
  canonical="https://thecustomstickers.co/privacy-policy/"
>
  <Header slot="header" />
  <WhatsAppButton />
  <div class="container" style="padding-top:20px">
    <Breadcrumb items={[{ label: 'Privacy Policy' }]} />
  </div>
  <section class="page-hero">
    <div class="container">
      <div class="badge">Legal</div>
      <h1>Privacy Policy</h1>
      <p>This Privacy Policy describes how The Custom Stickers collects, uses, and protects your personal information.</p>
    </div>
  </section>
  <section class="content-page">
    <div class="container content-body-wide">
      <p class="last-updated">Last Updated: January 2025</p>

      <h2>1. Information We Collect</h2>
      <p>We collect information you provide directly to us, including:</p>
      <ul class="policy-list">
        <li>Name, email address, phone number, and mailing address when you submit a quote request or contact form</li>
        <li>Order details, product specifications, and artwork files you upload</li>
        <li>Payment information processed securely through our payment partners (we do not store full card numbers)</li>
        <li>Communications you send us via email, phone, or contact forms</li>
      </ul>
      <p>We also automatically collect certain technical information when you visit our website, including IP address, browser type, pages visited, and referring URLs through standard web analytics tools.</p>

      <h2>2. How We Use Your Information</h2>
      <p>We use the information we collect to:</p>
      <ul class="policy-list">
        <li>Process and fulfill your custom sticker orders</li>
        <li>Respond to your quote requests and customer service inquiries</li>
        <li>Send order confirmations, shipping notifications, and updates</li>
        <li>Improve our website and services based on usage patterns</li>
        <li>Send promotional communications if you have opted in (you may unsubscribe at any time)</li>
        <li>Comply with legal obligations</li>
      </ul>

      <h2>3. Information Sharing</h2>
      <p>We do not sell, rent, or trade your personal information to third parties. We may share your information with:</p>
      <ul class="policy-list">
        <li><strong>Service providers:</strong> Shipping carriers, payment processors, and email service providers who assist in operating our business</li>
        <li><strong>Legal requirements:</strong> When required by law or to protect our rights</li>
      </ul>

      <h2>4. Data Security</h2>
      <p>We implement industry-standard security measures to protect your personal information, including SSL encryption for all data transmissions. However, no method of transmission over the Internet is 100% secure, and we cannot guarantee absolute security.</p>

      <h2>5. Cookies</h2>
      <p>Our website uses cookies to enhance your browsing experience, analyze traffic, and remember your preferences. You can control cookie settings through your browser. Disabling cookies may affect some website functionality.</p>

      <h2>6. Your Rights</h2>
      <p>You have the right to:</p>
      <ul class="policy-list">
        <li>Access the personal information we hold about you</li>
        <li>Request correction of inaccurate information</li>
        <li>Request deletion of your personal information (subject to legal obligations)</li>
        <li>Opt out of marketing communications at any time</li>
      </ul>

      <h2>7. Children's Privacy</h2>
      <p>Our website is not directed to children under the age of 13. We do not knowingly collect personal information from children. If you believe we have inadvertently collected information from a child, please contact us immediately.</p>

      <h2>8. Changes to This Policy</h2>
      <p>We may update this Privacy Policy from time to time. We will notify you of material changes by posting the updated policy on this page with a revised "Last Updated" date.</p>

      <h2>9. Contact Us</h2>
      <p>If you have questions about this Privacy Policy or our privacy practices, please contact us:</p>
      <ul class="policy-list">
        <li>📞 Phone: <a href="tel:5033580443">(503) 358-0443</a></li>
        <li>✉️ Email: <a href="mailto:info@thecustomstickers.co">info@thecustomstickers.co</a></li>
        <li>📍 Address: 2975 Coburn Hollow Road, Bloomington, IL 61701, United States</li>
      </ul>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, var(--dark), var(--gray-800)); padding: 80px 0; color: white; text-align: center; }
  .page-hero .badge { background: rgba(249,115,22,0.2); color: #fb923c; margin-bottom: 16px; }
  .page-hero h1 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); color: white; margin-bottom: 16px; }
  .page-hero p { color: rgba(255,255,255,0.75); max-width: 600px; margin: 0 auto; }
  .content-page { padding: 80px 0; background: var(--light-bg); }
  .content-body-wide { background: white; border-radius: 16px; padding: 48px; box-shadow: 0 4px 24px rgba(0,0,0,0.07); }
  .last-updated { font-size: 13px; color: var(--gray-500); margin-bottom: 32px; }
  .content-body-wide h2 { font-size: 1.3rem; margin: 36px 0 14px; padding-top: 12px; border-top: 1px solid var(--gray-100); }
  .content-body-wide h2:first-of-type { margin-top: 0; border-top: none; padding-top: 0; }
  .content-body-wide p { font-size: 15px; color: var(--gray-600); line-height: 1.75; margin-bottom: 16px; }
  .content-body-wide a { color: var(--accent); text-decoration: underline; }
  .policy-list { list-style: none; margin: 16px 0; }
  .policy-list li { padding: 8px 0 8px 20px; border-bottom: 1px solid var(--gray-100); font-size: 15px; color: var(--gray-700); position: relative; line-height: 1.6; }
  .policy-list li::before { content: '•'; position: absolute; left: 4px; color: var(--primary); font-weight: 700; }
  @media (max-width: 600px) { .content-body-wide { padding: 24px; } }
</style>
