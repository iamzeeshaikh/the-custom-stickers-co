---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import { locationStates, getLocationState, pickLinkTargets, anchorFor, seedNum } from '../../../data/locations';
import { products } from '../../../data/products';

export async function getStaticPaths() {
  return locationStates.map((s) => ({ params: { state: s.slug } }));
}

const { state: stateSlug } = Astro.params;
const state = getLocationState(stateSlug!);
if (!state) return Astro.redirect('/locations/');

const getP = (s: string) => products.find((p) => p.slug === s);
const featured = state.featuredProducts.map(getP).filter(Boolean) as NonNullable<ReturnType<typeof getP>>[];
const basePath = `/locations/${state.slug}/`;

// Varied internal links — different target, anchor, and sentence per state page.
const lt = pickLinkTargets(state.slug, 2);
const sseed = seedNum(state.slug);
const spick = <T,>(arr: T[], off = 0): T => arr[(sseed + off) % arr.length];
const L0 = { href: `/${lt[0]}/`, text: anchorFor(lt[0], state.slug, 0) };
const L1 = { href: `/${lt[1]}/`, text: anchorFor(lt[1], state.slug, 1) };
const sceneLine = spick([
  { pre: `Across the state, brands reach for our `, post: ` when they want to be remembered.` },
  { pre: `From cans to laptops, ${state.name} teams lean on our `, post: ` to carry a logo everywhere.` },
  { pre: `The most-ordered pick across ${state.name} tends to be our `, post: `, printed to spec and built to last.` },
  { pre: `Whatever the scene, our `, post: ` help ${state.name} brands stand out and stick around.` },
]);
const stateLine = spick([
  { pre: `Compare shapes, materials, and finishes across our `, post: `, then send your artwork for a quote.` },
  { pre: `Not sure which style fits? Start with our `, post: ` and we'll help you dial it in.` },
  { pre: `Explore the options — from bold to subtle — with our `, post: ` and request pricing.` },
], 1);

const faqs: [string, string][] = [
  [`Do you print custom stickers across ${state.name}?`, `Yes. We print and ship custom stickers and labels to businesses across ${state.name}, including ${state.cities.map((c) => c.name).join(', ')} and the surrounding areas. Upload your artwork for a quote.`],
  [`What is the minimum order?`, `Minimums stay low so smaller ${state.name} brands can order comfortably, with better per-unit pricing as volumes grow. Share your target quantity for a tailored quote.`],
  [`Can I get die cut stickers cut to my shape?`, `Yes — our die cut stickers are cut precisely to your design's outline with no borders, ideal for logos, characters, and custom shapes.`],
  [`Are the stickers waterproof and durable?`, `Yes. We print on durable, laminated waterproof vinyl that resists water, UV fading, and scratching, so your ${state.name} stickers last indoors or outdoors.`],
  [`What sticker finishes can I choose from?`, `Gloss, matte, holographic, clear, and metallic finishes are all available, so ${state.name} brands can match the look and feel of their identity exactly.`],
  [`What artwork files do you need?`, `We accept vector files (AI, EPS, PDF, SVG) and high-resolution PNG or JPG. If your file needs print prep, our team will help before anything goes to production.`],
  [`Do you send a proof before printing?`, `Yes. Every ${state.name} order includes a free digital proof so you can approve size, color, and the die-cut line before we print.`],
  [`How much do custom stickers cost?`, `Pricing depends on size, quantity, finish, and shape, but custom stickers are one of the most cost-effective branding tools available — especially in bulk. Request a fast quote for exact numbers.`],
  [`Can you print custom product labels too?`, `Yes. In addition to stickers, we print roll and sheet packaging labels for jars, bottles, boxes, and cans — popular with ${state.name} product makers and food brands.`],
  [`How fast can you ship stickers across ${state.name}?`, `Most orders print and ship on a quick turnaround to every ${state.name} address. If you have an event or launch deadline, tell us and we'll confirm timing up front.`],
];

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Custom Stickers in ${state.name}`,
    url: `https://thecustomstickers.co${basePath}`,
    description: state.metaDescription,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: state.cities.map((c, i) => ({
        '@type': 'ListItem', position: i + 1,
        name: `Custom Stickers in ${c.name}`,
        url: `https://thecustomstickers.co/locations/${state.slug}/${c.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })),
  },
]);
---
<Layout title={state.metaTitle} description={state.metaDescription} canonical={`https://thecustomstickers.co${basePath}`} schema={schema}>
  <Header slot="header" />

  <div class="container">
    <Breadcrumb items={[
      { label: 'Locations', href: '/locations/' },
      { label: state.name },
    ]} />
  </div>

  <section class="loc-hero">
    <div class="container loc-hero-grid">
      <div>
        <span class="badge">USA · {state.abbr}</span>
        <h1>{state.h1}</h1>
        <p class="loc-lead">{state.intro}</p>
        <div class="loc-cta-row">
          <a href="/get-a-quote/" class="btn-primary">Get a Free Quote</a>
          <a href="/locations/" class="btn-secondary">All USA Locations</a>
        </div>
      </div>
      <div class="loc-hero-card">
        <div class="loc-stat">📍 {state.stat}</div>
        <ul class="loc-check">
          {state.cities.map((c) => <li>{c.name}, {state.abbr}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Stat strip -->
  <section class="loc-strip">
    <div class="container loc-strip-grid">
      <div><strong>{state.cities.length} cities</strong><span>Served across {state.abbr}</span></div>
      <div><strong>Any shape</strong><span>Precision die cut</span></div>
      <div><strong>Waterproof</strong><span>Laminated vinyl</span></div>
      <div><strong>Free proof</strong><span>Approve before print</span></div>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container loc-split">
      <div>
        <h2>{state.sceneHeading}</h2>
        <p>{state.marketScene}</p>
        <p>{sceneLine.pre}<a href={L0.href}>{L0.text}</a>{sceneLine.post}</p>
      </div>
      <div>
        <QuoteForm productName={`Custom Stickers — ${state.name}`} compact={true} />
      </div>
    </div>
  </section>

  <section class="loc-section">
    <div class="container loc-narrow">
      <span class="badge">Who We Print For</span>
      <h2>{state.name} Brands We Serve</h2>
      <ul class="loc-industries">
        {state.industries.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container">
      <span class="badge">Cities</span>
      <h2>Custom Stickers by City in {state.name}</h2>
      <div class="loc-cards">
        {state.cities.map((c) => (
          <a href={`/locations/${state.slug}/${c.slug}/`} class="card loc-city-card">
            <h3>{c.name}, {state.abbr}</h3>
            <p>{c.intro.slice(0, 100)}…</p>
            <span class="loc-card-link">Stickers in {c.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="loc-section">
    <div class="container">
      <span class="badge">Popular Products</span>
      <h2>Stickers {state.name} Brands Order Most</h2>
      <div class="loc-cards">
        {featured.map((p) => (
          <a href={`/${p.slug}/`} class="card loc-card">
            <img src={p.images[0]} alt={`${p.name} in ${state.name}`} loading="lazy" width="400" height="300" />
            <div class="loc-card-body">
              <h3>{p.name}</h3>
              <p>{p.intro}</p>
              <span class="loc-card-link">View {p.name} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container loc-narrow">
      <span class="badge">Statewide Printing</span>
      <h2>One {state.name} Sticker Printer, Every City</h2>
      <p>Wherever your brand is based in {state.name}, you get the same crisp printing, precision die cutting, and durable waterproof material — with a free proof on every order. {stateLine.pre}<a href={L1.href}>{L1.text}</a>{stateLine.post}</p>
    </div>
  </section>

  <section class="loc-section">
    <div class="container loc-narrow">
      <span class="badge">FAQs</span>
      <h2>{state.name} Custom Stickers — Frequently Asked Questions</h2>
      <div class="loc-faq">
        {faqs.map(([q, a]) => (
          <details class="loc-faq-item">
            <summary>{q}</summary>
            <div class="loc-faq-a"><p set:html={a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="loc-cta">
    <div class="container loc-cta-inner">
      <h2>Print Custom Stickers Anywhere in {state.name}</h2>
      <p>Send your artwork for a free quote. We'll proof it for approval and ship fast to any {state.name} city.</p>
      <div class="loc-cta-row">
        <a href="/get-a-quote/" class="btn-primary">Get a Free Quote</a>
        <a href="/contact/" class="btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</Layout>

<style>
  .loc-hero { padding: 40px 0 24px; background: var(--light-bg); }
  .loc-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  .loc-hero h1 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin: 10px 0 14px; }
  .loc-lead { font-size: 1.05rem; color: var(--gray-600); margin-bottom: 20px; }
  .loc-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .loc-hero-card { background: white; border: 1px solid var(--gray-200); border-radius: 16px; padding: 24px; box-shadow: 0 2px 20px rgba(0,0,0,0.06); }
  .loc-stat { font-weight: 700; font-family: var(--font-heading); color: var(--dark); padding-bottom: 14px; margin-bottom: 14px; border-bottom: 1px solid var(--gray-200); }
  .loc-check li { position: relative; padding-left: 26px; margin-bottom: 10px; color: var(--gray-700); font-size: 0.95rem; }
  .loc-check li::before { content: '📍'; position: absolute; left: 0; font-size: 0.8rem; }

  .loc-strip { background: var(--dark); }
  .loc-strip-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 22px 20px; }
  .loc-strip-grid div { display: flex; flex-direction: column; text-align: center; }
  .loc-strip-grid strong { color: white; font-family: var(--font-heading); font-size: 1.15rem; }
  .loc-strip-grid span { color: rgba(255,255,255,0.6); font-size: 0.85rem; }

  .loc-section { padding: 44px 0; }
  .loc-alt { background: var(--light-bg); }
  .loc-section h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 8px 0 16px; }
  .loc-section > .container > p, .loc-narrow p, .loc-split p { color: var(--gray-600); margin-bottom: 14px; line-height: 1.75; }
  .loc-section a:not(.btn-primary):not(.btn-secondary):not(.loc-card):not(.loc-city-card):not(.loc-card-link) { color: var(--primary); font-weight: 600; text-decoration: underline; }
  .loc-narrow { max-width: 820px; }
  .loc-split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: start; }
  .loc-industries { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 24px; }
  .loc-industries li { position: relative; padding-left: 24px; color: var(--gray-700); line-height: 1.6; }
  .loc-industries li::before { content: '✓'; position: absolute; left: 0; color: var(--primary); font-weight: 800; }

  .loc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .loc-card img { width: 100%; height: 180px; object-fit: cover; }
  .loc-card-body, .loc-city-card { padding: 16px; }
  .loc-card-body h3, .loc-city-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .loc-card-body p, .loc-city-card p { font-size: 0.88rem; color: var(--gray-500); margin-bottom: 10px; }
  .loc-card-link { color: var(--primary); font-weight: 600; font-size: 0.88rem; }
  .loc-city-card { display: block; }

  .loc-faq-item { border-bottom: 1px solid var(--gray-200); }
  .loc-faq-item summary { padding: 16px 0; font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; color: var(--dark); }
  .loc-faq-item summary::after { content: '+'; color: var(--primary); font-size: 1.3rem; }
  .loc-faq-item[open] summary::after { content: '−'; }
  .loc-faq-a { padding: 0 0 16px; }
  .loc-faq-a p { margin: 0; font-size: 0.95rem; color: var(--gray-600); line-height: 1.7; }

  .loc-cta { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); padding: 48px 0; }
  .loc-cta-inner { text-align: center; max-width: 640px; margin: 0 auto; }
  .loc-cta-inner h2 { color: white; font-size: clamp(1.5rem, 2.8vw, 2.1rem); margin-bottom: 12px; }
  .loc-cta-inner p { color: rgba(255,255,255,0.85); margin-bottom: 22px; line-height: 1.7; }
  .loc-cta-inner .loc-cta-row { justify-content: center; }
  .loc-cta-inner .btn-secondary { background: transparent; color: white; border-color: rgba(255,255,255,0.5); }

  @media (max-width: 900px) {
    .loc-hero-grid, .loc-split { grid-template-columns: 1fr; gap: 24px; }
    .loc-cards, .loc-industries { grid-template-columns: 1fr; }
    .loc-strip-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; }
  }
</style>
