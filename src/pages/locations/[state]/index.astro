---
export const prerender = true;
import StickerStatePage from '../../../components/StickerStatePage.astro';
import { locationStates, getLocationState } from '../../../data/locations';

export async function getStaticPaths() {
  // Georgia lives at /georgia-custom-stickers/ instead of /locations/georgia.
  return locationStates.filter((s) => s.slug !== 'georgia').map((s) => ({ params: { state: s.slug } }));
}

const { state: stateSlug } = Astro.params;
const state = getLocationState(stateSlug!);
if (!state) return Astro.redirect('/locations/');
---
<StickerStatePage state={state} />
