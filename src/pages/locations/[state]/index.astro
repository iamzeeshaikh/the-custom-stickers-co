---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import { locationStates, getLocationState } from '../../../data/locations';
import { products } from '../../../data/products';

export async function getStaticPaths() {
  return locationStates.map((s) => ({ params: { state: s.slug } }));
}

const { state: stateSlug } = Astro.params;
const state = getLocationState(stateSlug!);
if (!state) return Astro.redirect('/locations/');

const getP = (s: string) => products.find((p) => p.slug === s);
const featured = state.featuredProducts.map(getP).filter(Boolean) as NonNullable<ReturnType<typeof getP>>[];
const basePath = `/locations/${state.slug}/`;

const faqs: [string, string][] = [
  [`Do you print custom stickers across ${state.name}?`, `Yes. We print and ship custom stickers and labels to businesses across ${state.name}, including ${state.cities.map((c) => c.name).join(', ')}. Upload your artwork for a quote.`],
  [`What is the minimum order?`, `Minimums stay low so smaller ${state.name} brands can order comfortably, with better per-unit pricing as volumes grow. Share your target quantity for a tailored quote.`],
  [`Can I get die cut stickers cut to my shape?`, `Yes — our <a href="/die-cut-stickers/">die cut stickers</a> are cut precisely to your design's outline, with no borders, ideal for logos and custom shapes.`],
  [`Are the stickers waterproof?`, `Yes. We print on durable waterproof vinyl that resists water, UV, and scratching, so your ${state.name} stickers last indoors or outdoors.`],
];

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Custom Stickers in ${state.name}`,
    url: `https://thecustomstickers.co${basePath}`,
    description: state.metaDescription,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: state.cities.map((c, i) => ({
        '@type': 'ListItem', position: i + 1,
        name: `Custom Stickers in ${c.name}`,
        url: `https://thecustomstickers.co/locations/${state.slug}/${c.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })),
  },
]);
---
<Layout title={state.metaTitle} description={state.metaDescription} canonical={`https://thecustomstickers.co${basePath}`} schema={schema}>
  <Header slot="header" />

  <div class="container">
    <Breadcrumb items={[
      { label: 'Locations', href: '/locations/' },
      { label: state.name },
    ]} />
  </div>

  <section class="loc-hero">
    <div class="container loc-hero-grid">
      <div>
        <span class="badge">USA · {state.abbr}</span>
        <h1>{state.h1}</h1>
        <p class="loc-lead">{state.intro}</p>
        <div class="loc-cta-row">
          <a href="/get-a-quote/" class="btn-primary">Get a Free Quote</a>
          <a href="/locations/" class="btn-secondary">All USA Locations</a>
        </div>
      </div>
      <div class="loc-hero-card">
        <div class="loc-stat">📍 {state.stat}</div>
        <ul class="loc-check">
          {state.cities.map((c) => <li>{c.name}, {state.abbr}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container loc-split">
      <div>
        <h2>{state.sceneHeading}</h2>
        <p>{state.marketScene}</p>
        <p>Across every scene here, the right sticker makes a brand stick — our <a href={`/${featured[0].slug}/`}>{featured[0].name.toLowerCase()}</a> are a popular choice for {state.name} brands.</p>
      </div>
      <div>
        <QuoteForm productName={`Custom Stickers — ${state.name}`} compact={true} />
      </div>
    </div>
  </section>

  <section class="loc-section">
    <div class="container loc-narrow">
      <span class="badge">Who We Print For</span>
      <h2>{state.name} Brands We Serve</h2>
      <ul class="loc-industries">
        {state.industries.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container">
      <span class="badge">Cities</span>
      <h2>Custom Stickers by City in {state.name}</h2>
      <div class="loc-cards">
        {state.cities.map((c) => (
          <a href={`/locations/${state.slug}/${c.slug}/`} class="card loc-city-card">
            <h3>{c.name}, {state.abbr}</h3>
            <p>{c.intro.slice(0, 100)}…</p>
            <span class="loc-card-link">Stickers in {c.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="loc-section">
    <div class="container">
      <span class="badge">Popular Products</span>
      <h2>Stickers {state.name} Brands Order Most</h2>
      <div class="loc-cards">
        {featured.map((p) => (
          <a href={`/${p.slug}/`} class="card loc-card">
            <img src={p.images[0]} alt={`${p.name} in ${state.name}`} loading="lazy" width="400" height="300" />
            <div class="loc-card-body">
              <h3>{p.name}</h3>
              <p>{p.intro}</p>
              <span class="loc-card-link">View {p.name} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container loc-narrow">
      <span class="badge">FAQs</span>
      <h2>{state.name} Custom Stickers — FAQs</h2>
      <div class="loc-faq">
        {faqs.map(([q, a]) => (
          <details class="loc-faq-item">
            <summary>{q}</summary>
            <div class="loc-faq-a"><p set:html={a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</Layout>

<style>
  .loc-hero { padding: 40px 0 20px; background: var(--light-bg); }
  .loc-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  .loc-hero h1 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin: 10px 0 14px; }
  .loc-lead { font-size: 1.05rem; color: var(--gray-600); margin-bottom: 20px; }
  .loc-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .loc-hero-card { background: white; border: 1px solid var(--gray-200); border-radius: 16px; padding: 24px; box-shadow: 0 2px 20px rgba(0,0,0,0.06); }
  .loc-stat { font-weight: 700; font-family: var(--font-heading); color: var(--dark); padding-bottom: 14px; margin-bottom: 14px; border-bottom: 1px solid var(--gray-200); }
  .loc-check li { position: relative; padding-left: 26px; margin-bottom: 10px; color: var(--gray-700); font-size: 0.95rem; }
  .loc-check li::before { content: '📍'; position: absolute; left: 0; font-size: 0.8rem; }

  .loc-section { padding: 44px 0; }
  .loc-alt { background: var(--light-bg); }
  .loc-section h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 8px 0 16px; }
  .loc-section p { color: var(--gray-600); margin-bottom: 14px; line-height: 1.75; }
  .loc-section a:not(.btn-primary):not(.btn-secondary):not(.loc-card):not(.loc-city-card):not(.loc-card-link) { color: var(--primary); font-weight: 600; text-decoration: underline; }
  .loc-narrow { max-width: 820px; }
  .loc-split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: start; }
  .loc-industries { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 24px; }
  .loc-industries li { position: relative; padding-left: 24px; color: var(--gray-700); }
  .loc-industries li::before { content: '✓'; position: absolute; left: 0; color: var(--primary); font-weight: 800; }

  .loc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .loc-card img { width: 100%; height: 180px; object-fit: cover; }
  .loc-card-body, .loc-city-card { padding: 16px; }
  .loc-card-body h3, .loc-city-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .loc-card-body p, .loc-city-card p { font-size: 0.88rem; color: var(--gray-500); margin-bottom: 10px; }
  .loc-card-link { color: var(--primary); font-weight: 600; font-size: 0.88rem; }
  .loc-city-card { display: block; }

  .loc-faq-item { border-bottom: 1px solid var(--gray-200); }
  .loc-faq-item summary { padding: 16px 0; font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; color: var(--dark); }
  .loc-faq-item summary::after { content: '+'; color: var(--primary); font-size: 1.3rem; }
  .loc-faq-item[open] summary::after { content: '−'; }
  .loc-faq-a { padding: 0 0 16px; }
  .loc-faq-a p { margin: 0; font-size: 0.95rem; }

  @media (max-width: 900px) {
    .loc-hero-grid, .loc-split { grid-template-columns: 1fr; gap: 24px; }
    .loc-cards, .loc-industries { grid-template-columns: 1fr; }
  }
</style>
