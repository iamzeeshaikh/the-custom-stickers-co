---
export const prerender = true;
import StickerCityPage from '../../../../components/StickerCityPage.astro';
import { locationStates, getLocationCity } from '../../../../data/locations';

export async function getStaticPaths() {
  // Georgia cities live under /georgia-custom-stickers/ instead of /locations/georgia.
  return locationStates
    .filter((s) => s.slug !== 'georgia')
    .flatMap((s) => s.cities.map((c) => ({ params: { state: s.slug, city: c.slug } })));
}

const { state: stateSlug, city: citySlug } = Astro.params;
const found = getLocationCity(stateSlug!, citySlug!);
if (!found) return Astro.redirect('/locations/');
---
<StickerCityPage state={found.state} city={found.city} />
