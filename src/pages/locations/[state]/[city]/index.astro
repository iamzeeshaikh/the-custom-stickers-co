---
export const prerender = true;
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import WhatsAppButton from '../../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import { allCityParams, getLocationCity } from '../../../../data/locations';
import { products } from '../../../../data/products';

export async function getStaticPaths() {
  return allCityParams().map((p) => ({ params: p }));
}

const { state: stateSlug, city: citySlug } = Astro.params;
const found = getLocationCity(stateSlug!, citySlug!);
if (!found) return Astro.redirect('/locations/');
const { state, city } = found;

const getP = (s: string) => products.find((p) => p.slug === s);
const featured = city.featuredProducts.map(getP).filter(Boolean) as NonNullable<ReturnType<typeof getP>>[];
const siblings = state.cities.filter((c) => c.slug !== city.slug);
const basePath = `/locations/${state.slug}/${city.slug}/`;

const seed = city.slug.split('').reduce((s, c) => s + c.charCodeAt(0), 0);
const pick = (arr: string[], off = 0) => arr[(seed + off) % arr.length];
const answerHeading = pick([
  `Custom Stickers in ${city.name}`,
  `Custom Sticker Printing for ${city.name}`,
  `${city.name} Custom Sticker & Label Printing`,
]);
const whyHeading = pick([
  `Why ${city.name} Brands Print With Us`,
  `The ${city.name} Sticker Printer Brands Trust`,
  `What Makes Our ${city.name} Printing Different`,
], 1);
const useHeading = pick([
  `What ${city.name} Brands Put Stickers On`,
  `Where ${city.name} Businesses Use Our Stickers`,
  `How ${city.name} Brands Use Custom Stickers`,
], 2);

// What people stick — varied surface list, city-relevant
const surfaces = [
  'Laptops, phones, and hardware cases',
  'Water bottles, tumblers, and drinkware',
  'Product packaging, boxes, and mailers',
  'Storefront windows and glass doors',
  'Merch tables, apparel drops, and swag bags',
  'Cars, bumpers, helmets, and gear',
];

const faqs: [string, string][] = [
  [`Do you print custom stickers for ${city.name} businesses?`, city.faqCityAnswer],
  [`What is the minimum order for ${city.name} brands?`, `Our minimums stay low so small ${city.name} brands, bands, and makers can order without a huge commitment — and the per-sticker price drops fast as your quantity grows. Tell us your target quantity and we'll send exact pricing.`],
  [`Can I get die cut stickers cut to my own shape?`, `Yes. Our <a href="/die-cut-stickers/">die cut stickers</a> are cut precisely around your artwork's outline with no borders or wasted space — ideal for logos, characters, mascots, and any custom shape.`],
  [`Are your stickers waterproof and weatherproof?`, `Yes. We print on premium waterproof vinyl with a protective laminate, so your ${city.name} stickers survive rain, sun, scratching, dishwashers, and daily handling on bottles, laptops, and cars.`],
  [`What sticker finishes do you offer?`, `You can choose gloss, matte, holographic, clear, metallic, and specialty finishes. Each gives a different look and feel, so ${city.name} brands can match their stickers to their exact identity — bold and shiny or clean and subtle.`],
  [`What artwork files do you need?`, `We accept vector files (AI, EPS, PDF, SVG) and high-resolution PNG or JPG. If your file needs cleanup for print, our team will help — see our artwork guidelines or just send what you have and we'll advise.`],
  [`Do you send a proof before printing?`, `Always. Every ${city.name} order includes a free digital proof so you can check size, color, and the die-cut line before anything is printed. Nothing goes to production until you approve it.`],
  [`How much do custom stickers cost?`, `Cost depends on size, quantity, finish, and shape, but custom stickers are one of the most affordable branding tools there is — especially in volume. Send your details for a fast, no-obligation quote.`],
  [`Can you print custom product labels too?`, `Yes. Alongside stickers, we print roll and sheet packaging labels for jars, bottles, boxes, and cans — a favorite of ${city.name} makers and product brands.`],
  [`Do you print stickers for events, bands, and merch?`, `Absolutely. Die cut and holographic stickers are a top-selling, low-cost merch item, and we regularly print for ${city.name} bands, festivals, pop-ups, and events — from small batches to large runs.`],
  [`How fast can you ship stickers to ${city.name}?`, `Most orders print and ship on a quick turnaround, and we deliver to every ${city.name} ZIP code. If you have an event or launch deadline, tell us and we'll confirm timing up front.`],
];

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Custom Sticker Printing — ${city.name}, ${state.abbr}`,
    serviceType: 'Custom sticker and label printing',
    description: city.metaDescription,
    url: `https://thecustomstickers.co${basePath}`,
    provider: { '@type': 'Organization', name: 'The Custom Stickers', url: 'https://thecustomstickers.co' },
    areaServed: { '@type': 'City', name: city.name, containedInPlace: { '@type': 'State', name: `${state.name}, USA` } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })),
  },
]);
---
<Layout title={city.metaTitle} description={city.metaDescription} canonical={`https://thecustomstickers.co${basePath}`} schema={schema}>
  <Header slot="header" />

  <div class="container">
    <Breadcrumb items={[
      { label: 'Locations', href: '/locations/' },
      { label: state.name, href: `/locations/${state.slug}/` },
      { label: city.name },
    ]} />
  </div>

  <!-- Hero -->
  <section class="loc-hero">
    <div class="container loc-hero-grid">
      <div>
        <span class="badge">{state.name} · USA</span>
        <h1>{city.h1}</h1>
        <p class="loc-lead">{city.intro}</p>
        <div class="loc-cta-row">
          <a href="/get-a-quote/" class="btn-primary">Get a Free Quote</a>
          <a href={`/locations/${state.slug}/`} class="btn-secondary">All {state.name} Locations</a>
        </div>
      </div>
      <div class="loc-hero-card">
        <div class="loc-stat">📍 {city.stat}</div>
        <ul class="loc-check">
          <li>Die cut to any custom shape</li>
          <li>Waterproof, laminated vinyl</li>
          <li>Printed to your exact artwork</li>
          <li>Free proof · fast turnaround</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Stat strip -->
  <section class="loc-strip">
    <div class="container loc-strip-grid">
      <div><strong>Any shape</strong><span>Precision die cut</span></div>
      <div><strong>Waterproof</strong><span>UV &amp; scratch proof</span></div>
      <div><strong>Low minimums</strong><span>Small &amp; bulk runs</span></div>
      <div><strong>Free proof</strong><span>Approve before print</span></div>
    </div>
  </section>

  <!-- Answer-first -->
  <section class="loc-section">
    <div class="container loc-narrow">
      <h2>{answerHeading}</h2>
      <p>The Custom Stickers prints custom die cut, vinyl, and label stickers for businesses across {city.name} and {state.name}. Every order is printed to your artwork on premium, laminated waterproof material — built for {city.signatureSector} and any brand that wants its logo to travel. A go-to for {city.name} brands is our <a href={`/${featured[0].slug}/`}>{featured[0].name.toLowerCase()}</a>, printed sharp, cut clean, and made to last.</p>
    </div>
  </section>

  <!-- Local scene + districts -->
  <section class="loc-section loc-alt">
    <div class="container loc-split">
      <div>
        <span class="badge">On the Ground in {city.name}</span>
        <h2>{city.sceneHeading}</h2>
        <p>{city.localScene}</p>
        <p>However your brand shows up around {city.name}, the right sticker makes it stick. Our <a href={`/${featured[1].slug}/`}>{featured[1].name.toLowerCase()}</a> fit the way {city.name} brands build an identity people want to carry.</p>
        <h3 class="loc-h3">Areas We Serve in {city.name}</h3>
        <div class="loc-tags">
          {city.districts.map((d) => <span class="loc-tag">{d}</span>)}
        </div>
      </div>
      <div>
        <QuoteForm productName={`Custom Stickers — ${city.name}, ${state.abbr}`} compact={true} />
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="loc-section">
    <div class="container loc-narrow">
      <span class="badge">Where They Go</span>
      <h2>{useHeading}</h2>
      <p>{city.name} brands put our stickers just about everywhere their customers look. Popular surfaces include our durable <a href={`/${featured[2].slug}/`}>{featured[2].name.toLowerCase()}</a> and beyond:</p>
      <ul class="loc-surfaces">
        {surfaces.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <!-- Popular products -->
  <section class="loc-section loc-alt">
    <div class="container">
      <span class="badge">Popular in {city.name}</span>
      <h2>Stickers {city.name} Brands Order Most</h2>
      <div class="loc-cards">
        {featured.map((p) => (
          <a href={`/${p.slug}/`} class="card loc-card">
            <img src={p.images[0]} alt={`${p.name} in ${city.name}`} loading="lazy" width="400" height="300" />
            <div class="loc-card-body">
              <h3>{p.name}</h3>
              <p>{p.intro}</p>
              <span class="loc-card-link">View {p.name} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="loc-section">
    <div class="container">
      <span class="badge">Simple Process</span>
      <h2>How Ordering Stickers in {city.name} Works</h2>
      <div class="loc-steps">
        <div class="loc-step"><span class="loc-step-n">1</span><h3>Send your artwork &amp; get a quote</h3><p>Upload your design and quantity for a fast, free quote. Not print-ready? We'll help clean it up.</p></div>
        <div class="loc-step"><span class="loc-step-n">2</span><h3>Approve your free proof</h3><p>We send a digital proof showing size, color, and the die-cut line. Nothing prints until you say go.</p></div>
        <div class="loc-step"><span class="loc-step-n">3</span><h3>We print &amp; ship to {city.name}</h3><p>Your stickers print on premium waterproof vinyl and ship fast to your {city.name} address.</p></div>
      </div>
      <p class="loc-note">New to print files? Our <a href="/artwork-guidelines/">artwork guidelines</a> walk you through sizes, bleed, and formats.</p>
    </div>
  </section>

  <!-- Why us -->
  <section class="loc-section loc-alt">
    <div class="container loc-narrow">
      <span class="badge">Why Us</span>
      <h2>{whyHeading}</h2>
      <p>{city.deliveryNote}</p>
      <ul class="loc-why">
        <li>Precision die cutting to any shape</li>
        <li>Premium laminated, waterproof vinyl</li>
        <li>Vibrant, color-accurate printing</li>
        <li>Free digital proof on every order</li>
        <li>Low minimums with bulk pricing</li>
        <li>Fast turnaround and nationwide shipping</li>
      </ul>
      <p>Ready to compare options? Explore our full range of <a href="/custom-sticker-printing/">custom sticker printing</a> or start a {city.name} quote today.</p>
    </div>
  </section>

  <!-- Nearby cities -->
  {siblings.length > 0 && (
    <section class="loc-section">
      <div class="container">
        <span class="badge">Also Serving</span>
        <h2>Other {state.name} Cities We Print For</h2>
        <div class="loc-cards">
          {siblings.map((c) => (
            <a href={`/locations/${state.slug}/${c.slug}/`} class="card loc-city-card">
              <h3>{c.name}, {state.abbr}</h3>
              <p>{c.intro.slice(0, 95)}…</p>
              <span class="loc-card-link">Stickers in {c.name} →</span>
            </a>
          ))}
        </div>
        <p class="loc-note"><a href="/locations/">View all USA sticker locations →</a></p>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="loc-section loc-alt">
    <div class="container loc-narrow">
      <span class="badge">FAQs</span>
      <h2>{city.name} Custom Stickers — Frequently Asked Questions</h2>
      <div class="loc-faq">
        {faqs.map(([q, a]) => (
          <details class="loc-faq-item">
            <summary>{q}</summary>
            <div class="loc-faq-a"><p set:html={a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="loc-cta">
    <div class="container loc-cta-inner">
      <h2>Ready to Print Custom Stickers in {city.name}?</h2>
      <p>Send your artwork for a free, no-obligation quote. We'll confirm your size, finish, and shape, proof it for approval, and ship fast to {city.name}.</p>
      <div class="loc-cta-row">
        <a href="/get-a-quote/" class="btn-primary">Get a Free Quote</a>
        <a href="/contact/" class="btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</Layout>

<style>
  .loc-hero { padding: 40px 0 24px; background: var(--light-bg); }
  .loc-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  .loc-hero h1 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin: 10px 0 14px; }
  .loc-lead { font-size: 1.05rem; color: var(--gray-600); margin-bottom: 20px; }
  .loc-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .loc-hero-card { background: white; border: 1px solid var(--gray-200); border-radius: 16px; padding: 24px; box-shadow: 0 2px 20px rgba(0,0,0,0.06); }
  .loc-stat { font-weight: 700; font-family: var(--font-heading); color: var(--dark); padding-bottom: 14px; margin-bottom: 14px; border-bottom: 1px solid var(--gray-200); }
  .loc-check li { position: relative; padding-left: 26px; margin-bottom: 10px; color: var(--gray-700); font-size: 0.95rem; }
  .loc-check li::before { content: '✓'; position: absolute; left: 0; color: var(--primary); font-weight: 800; }

  .loc-strip { background: var(--dark); }
  .loc-strip-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 22px 20px; }
  .loc-strip-grid div { display: flex; flex-direction: column; text-align: center; }
  .loc-strip-grid strong { color: white; font-family: var(--font-heading); font-size: 1.15rem; }
  .loc-strip-grid span { color: rgba(255,255,255,0.6); font-size: 0.85rem; }

  .loc-section { padding: 44px 0; }
  .loc-alt { background: var(--light-bg); }
  .loc-section h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 8px 0 16px; }
  .loc-section > .container > p, .loc-narrow p, .loc-split p { color: var(--gray-600); margin-bottom: 14px; line-height: 1.75; }
  .loc-section a:not(.btn-primary):not(.btn-secondary):not(.loc-card):not(.loc-city-card):not(.loc-card-link) { color: var(--primary); font-weight: 600; text-decoration: underline; }
  .loc-narrow { max-width: 820px; }
  .loc-split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: start; }
  .loc-h3 { margin: 20px 0 12px; font-size: 1.1rem; }
  .loc-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .loc-tag { background: white; border: 1px solid var(--gray-200); border-radius: 100px; padding: 6px 14px; font-size: 0.85rem; color: var(--gray-700); }

  .loc-surfaces { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 24px; margin-top: 8px; }
  .loc-surfaces li { position: relative; padding-left: 24px; color: var(--gray-700); line-height: 1.6; }
  .loc-surfaces li::before { content: '→'; position: absolute; left: 0; color: var(--primary); font-weight: 800; }

  .loc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .loc-card img { width: 100%; height: 180px; object-fit: cover; }
  .loc-card-body, .loc-city-card { padding: 16px; }
  .loc-card-body h3, .loc-city-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .loc-card-body p, .loc-city-card p { font-size: 0.88rem; color: var(--gray-500); margin-bottom: 10px; }
  .loc-card-link { color: var(--primary); font-weight: 600; font-size: 0.88rem; }
  .loc-city-card { display: block; }
  .loc-note { margin-top: 18px; }

  .loc-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .loc-step { background: white; border: 1px solid var(--gray-200); border-radius: 14px; padding: 22px; }
  .loc-step-n { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: var(--primary); color: white; font-weight: 800; font-family: var(--font-heading); margin-bottom: 12px; }
  .loc-step h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .loc-step p { font-size: 0.9rem; color: var(--gray-500); margin: 0; line-height: 1.6; }

  .loc-why { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 24px; margin: 4px 0 16px; }
  .loc-why li { position: relative; padding-left: 24px; color: var(--gray-700); line-height: 1.6; }
  .loc-why li::before { content: '✓'; position: absolute; left: 0; color: var(--primary); font-weight: 800; }

  .loc-faq-item { border-bottom: 1px solid var(--gray-200); }
  .loc-faq-item summary { padding: 16px 0; font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; color: var(--dark); }
  .loc-faq-item summary::after { content: '+'; color: var(--primary); font-size: 1.3rem; }
  .loc-faq-item[open] summary::after { content: '−'; }
  .loc-faq-a { padding: 0 0 16px; }
  .loc-faq-a p { margin: 0; font-size: 0.95rem; color: var(--gray-600); line-height: 1.7; }

  .loc-cta { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); padding: 48px 0; }
  .loc-cta-inner { text-align: center; max-width: 640px; margin: 0 auto; }
  .loc-cta-inner h2 { color: white; font-size: clamp(1.5rem, 2.8vw, 2.1rem); margin-bottom: 12px; }
  .loc-cta-inner p { color: rgba(255,255,255,0.85); margin-bottom: 22px; line-height: 1.7; }
  .loc-cta-inner .loc-cta-row { justify-content: center; }
  .loc-cta-inner .btn-secondary { background: transparent; color: white; border-color: rgba(255,255,255,0.5); }

  @media (max-width: 900px) {
    .loc-hero-grid, .loc-split, .loc-steps { grid-template-columns: 1fr; gap: 24px; }
    .loc-cards, .loc-surfaces, .loc-why { grid-template-columns: 1fr; }
    .loc-strip-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; }
  }
</style>
