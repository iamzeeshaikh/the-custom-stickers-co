---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { locationStates, stateUrl } from '../../data/locations';

const totalCities = locationStates.reduce((n, s) => n + s.cities.length, 0);
const basePath = '/locations/';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'USA Sticker Printing Locations — The Custom Stickers',
  itemListElement: locationStates.map((s, i) => ({
    '@type': 'ListItem', position: i + 1,
    name: `Custom Stickers in ${s.name}`,
    url: `https://thecustomstickers.co${stateUrl(s)}`,
  })),
});
---
<Layout
  title="Custom Stickers Across the USA | State & City Printing | The Custom Stickers"
  description="The Custom Stickers prints custom die cut, vinyl, and label stickers for businesses across the USA — browse locations by state and city, or request a free quote."
  canonical={`https://thecustomstickers.co${basePath}`}
  schema={schema}
>
  <Header slot="header" />

  <div class="container">
    <Breadcrumb items={[{ label: 'Locations' }]} />
  </div>

  <section class="loc-hero">
    <div class="container">
      <span class="badge">USA Sticker Printing</span>
      <h1>Custom Stickers Printed Across the USA</h1>
      <p class="loc-lead">From LA streetwear and Seattle coffee roasters to Austin bands and Chicago breweries, we print custom die cut, vinyl, and label stickers for brands in every corner of the country. Browse {locationStates.length} states and {totalCities} cities, or <a href="/get-a-quote/">get a free quote</a> to start.</p>
    </div>
  </section>

  <section class="loc-section">
    <div class="container">
      <span class="badge">By State</span>
      <h2>Find a Custom Sticker Printer in Your State</h2>
      <div class="loc-cards">
        {locationStates.map((s) => (
          <a href={stateUrl(s)} class="card loc-city-card">
            <h3>{s.name} ({s.abbr})</h3>
            <p>{s.stat}. Serving {s.cities.map((c) => c.name).join(', ')}.</p>
            <span class="loc-card-link">Stickers in {s.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="loc-section loc-alt">
    <div class="container loc-split">
      <div>
        <h2>Nationwide Custom Sticker Printing</h2>
        <p>Wherever your brand is based, The Custom Stickers prints die cut, vinyl, holographic, and label stickers on premium waterproof material — cut to any shape and printed to your artwork. We ship nationwide with fast turnaround and free quotes.</p>
        <p>Don't see your city listed yet? We print for brands across the whole country — tell us where you are and what you need, and we'll get you a quote.</p>
      </div>
      <div>
        <QuoteForm productName="Custom Stickers — USA" compact={true} />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</Layout>

<style>
  .loc-hero { padding: 44px 0 24px; background: var(--light-bg); }
  .loc-hero h1 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); margin: 8px 0 14px; }
  .loc-lead { font-size: 1.08rem; color: var(--gray-600); max-width: 780px; line-height: 1.75; }
  .loc-lead a { color: var(--primary); font-weight: 600; text-decoration: underline; }

  .loc-section { padding: 44px 0; }
  .loc-alt { background: var(--light-bg); }
  .loc-section h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 8px 0 16px; }
  .loc-section p { color: var(--gray-600); margin-bottom: 14px; line-height: 1.75; }
  .loc-split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: start; }

  .loc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .loc-city-card { display: block; padding: 18px; }
  .loc-city-card h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .loc-city-card p { font-size: 0.9rem; color: var(--gray-500); margin-bottom: 10px; }
  .loc-card-link { color: var(--primary); font-weight: 600; font-size: 0.9rem; }

  @media (max-width: 900px) {
    .loc-split { grid-template-columns: 1fr; gap: 24px; }
    .loc-cards { grid-template-columns: 1fr; }
  }
</style>
