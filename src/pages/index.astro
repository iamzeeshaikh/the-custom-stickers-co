---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { imgThumb } from '../lib/img';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { featuredProducts } from '../data/products';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What types of custom stickers do you offer?", "acceptedAnswer": { "@type": "Answer", "text": "We offer over 100 sticker types including die cut stickers, vinyl stickers, waterproof stickers, holographic stickers, clear stickers, matte stickers, glossy stickers, bumper stickers, packaging labels, and many more." }},
    { "@type": "Question", "name": "What is the minimum order quantity?", "acceptedAnswer": { "@type": "Answer", "text": "Our minimum order is 50 stickers. We offer competitive bulk pricing for orders of 250, 500, 1,000, and above with greater discounts at higher quantities." }},
    { "@type": "Question", "name": "How long does production take?", "acceptedAnswer": { "@type": "Answer", "text": "Standard production takes 3-5 business days after artwork approval. Rush production (1-2 business days) is available for an additional fee." }},
    { "@type": "Question", "name": "Do you offer free proofs?", "acceptedAnswer": { "@type": "Answer", "text": "Yes! We provide free digital proofs for every order before printing. You approve the proof before we start production." }},
  ]
});
---
<Layout
  title="Custom Sticker Printing | Die Cut, Vinyl & Waterproof Stickers | The Custom Stickers"
  description="Premium custom sticker printing — die cut stickers, vinyl stickers, waterproof stickers, holographic stickers, packaging labels & more. Fast shipping, wholesale prices. Get a free quote today."
  schema={faqSchema}
>
  <Header slot="header" />
  <WhatsAppButton />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="badge">⭐ Premium Custom Sticker Printing</div>
        <h1 class="hero-h1">Custom Stickers That <span class="hero-highlight">Make Your Brand</span> Unforgettable</h1>
        <p class="hero-desc">Die cut stickers, waterproof vinyl, holographic foil, clear labels, packaging stickers, and 100+ custom sticker types. Wholesale prices. Fast turnaround.</p>
        <div class="hero-actions">
          <a href="/get-a-quote/" class="btn-primary">Get Free Quote →</a>
          <a href="/die-cut-stickers/" class="btn-secondary">Shop Die Cut Stickers</a>
        </div>
        <div class="hero-trust">
          <span>✅ Free Artwork Review</span>
          <span>✅ No Setup Fees</span>
          <span>✅ Fast Shipping</span>
          <span>✅ Bulk Discounts</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-img-stack">
          <div class="hero-img-main">
            <img src="/images/die-cut-stickers/1.webp" alt="Custom die cut stickers premium quality printing" loading="eager" fetchpriority="high" decoding="async" width="480" height="380" />
          </div>
          <div class="hero-img-float float-1">
            <img src="/images/custom-holographic-stickers/1-400.webp" alt="Custom holographic stickers with rainbow foil effect" loading="lazy" decoding="async" width="160" height="130" />
          </div>
          <div class="hero-img-float float-2">
            <img src="/images/waterproof-stickers/1-400.webp" alt="Waterproof custom vinyl stickers" loading="lazy" decoding="async" width="130" height="110" />
          </div>
          <div class="hero-badge-float">
            <span class="hbf-number">100+</span>
            <span class="hbf-text">Sticker Types</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="trust-bar">
    <div class="container trust-grid">
      {[
        { icon: '🎨', title: 'Free Artwork Review', desc: 'Expert review before printing' },
        { icon: '⚡', title: 'Fast Turnaround', desc: '3-5 business day production' },
        { icon: '💧', title: 'Waterproof Quality', desc: 'UV-resistant & durable' },
        { icon: '📦', title: 'Bulk Pricing', desc: 'Wholesale rates available' },
        { icon: '🔄', title: '100% Satisfaction', desc: 'Free reprint if needed' },
        { icon: '🚀', title: 'Fast Shipping', desc: 'Ships across the USA' },
      ].map(badge => (
        <div class="trust-item">
          <span class="trust-icon">{badge.icon}</span>
          <div>
            <strong>{badge.title}</strong>
            <span>{badge.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Products -->
  <section class="featured-products">
    <div class="container">
      <div class="section-header">
        <div class="badge">Our Products</div>
        <h2 class="section-title">Premium Custom Sticker Printing</h2>
        <p class="section-subtitle">From die cut stickers to holographic labels — every sticker type printed to perfection.</p>
      </div>
      <div class="products-grid">
        {featuredProducts.slice(0, 12).map(product => (
          <a href={`/${product.slug}/`} class="product-card card">
            <div class="product-img">
              <img
                src={imgThumb(product.images[0])}
                alt={product.name}
                loading="lazy"
                decoding="async"
                width="320"
                height="240"
              />
              <div class="product-overlay">View Product →</div>
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.intro.slice(0, 80)}...</p>
              <span class="product-cta">Get Quote →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="view-all-cta">
        <a href="/stickers-and-labels/" class="btn-secondary">View All Sticker Products →</a>
      </div>
    </div>
  </section>

  <!-- Custom Sticker Printing for Every Business -->
  <section class="for-business">
    <div class="container">
      <div class="for-business-grid">
        <div class="for-business-content">
          <div class="badge">For Every Business</div>
          <h2 class="section-title">Custom Sticker Printing for Every Business</h2>
          <p>Whether you're a small Etsy shop, a growing brand, or a large corporation, our <a href="/custom-sticker-printing/">custom sticker printing</a> service scales to your needs.</p>
          <ul class="business-list">
            <li>📦 <strong>E-Commerce & Retail</strong> — Brand your packaging with <a href="/packaging-labels/">custom packaging labels</a>, thank you stickers, and product seals</li>
            <li>🍕 <strong>Food & Beverage</strong> — Professional <a href="/bakery-stickers/">bakery stickers</a>, <a href="/personalised-pizza-box-stickers/">pizza box stickers</a>, and food-grade labels</li>
            <li>🚗 <strong>Automotive</strong> — Durable <a href="/bumper-stickers/">custom bumper stickers</a>, <a href="/car-stickers/">car decals</a>, and service reminder stickers</li>
            <li>🎉 <strong>Events & Promotions</strong> — Eye-catching <a href="/promotional-stickers/">promotional stickers</a> and <a href="/custom-business-stickers/">business branding stickers</a></li>
            <li>🏫 <strong>Schools & Education</strong> — Motivational <a href="/school-stickers/">school stickers</a>, reward labels, and name tags</li>
            <li>🖥️ <strong>Tech & Creators</strong> — Custom <a href="/custom-laptop-stickers/">laptop stickers</a>, brand merch, and influencer packs</li>
          </ul>
          <a href="/get-a-quote/" class="btn-primary">Get a Free Quote →</a>
        </div>
        <div class="for-business-visual">
          <div class="biz-img-grid">
            <img src="/images/packaging-labels/1-400.webp" alt="Custom packaging labels for business" loading="lazy" decoding="async" width="200" height="160" />
            <img src="/images/promotional-stickers/1-400.webp" alt="Promotional stickers for marketing" loading="lazy" decoding="async" width="200" height="160" />
            <img src="/images/custom-business-stickers/Custom Business Stickers-1-400.webp" alt="Custom business stickers with logo branding" loading="lazy" decoding="async" width="200" height="160" />
            <img src="/images/bumper-stickers/bumper stickers-1-400.webp" alt="Custom bumper stickers for cars" loading="lazy" decoding="async" width="200" height="160" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Materials Section -->
  <section class="materials-section">
    <div class="container">
      <div class="section-header centered">
        <div class="badge">Premium Materials</div>
        <h2 class="section-title">Sticker Materials for Every Application</h2>
        <p class="section-subtitle">We print on premium materials selected for durability, appearance, and application.</p>
      </div>
      <div class="materials-grid">
        {[
          { name: 'Vinyl', desc: 'Durable, waterproof, UV-resistant. The most popular choice for all-purpose use.', icon: '💧', href: '/custom-vinyl-stickers/' },
          { name: 'Clear Vinyl', desc: 'Transparent background that blends with any surface for a seamless professional look.', icon: '🔍', href: '/custom-clear-stickers/' },
          { name: 'Holographic', desc: 'Rainbow foil effect that catches every eye. Perfect for premium brands.', icon: '✨', href: '/custom-holographic-stickers/' },
          { name: 'Metallic', desc: 'Gold, silver, and chrome finishes for luxury product packaging and branding.', icon: '⭐', href: '/metallic-stickers/' },
          { name: 'Paper', desc: 'Eco-friendly option for indoor use, packaging, and budget-conscious projects.', icon: '🌿', href: '/paper-stickers/' },
          { name: 'Reflective', desc: 'High-visibility material for safety, vehicles, and outdoor applications.', icon: '🔦', href: '/reflective-stickers/' },
        ].map(mat => (
          <a href={mat.href} class="material-card card">
            <span class="mat-icon">{mat.icon}</span>
            <h3>{mat.name}</h3>
            <p>{mat.desc}</p>
            <span class="mat-link">Learn More →</span>
          </a>
        ))}
      </div>
      <div class="centered-link">
        <a href="/sticker-materials/" class="btn-secondary">View All Materials →</a>
      </div>
    </div>
  </section>

  <!-- Shapes & Finishes -->
  <section class="shapes-section">
    <div class="container">
      <div class="section-header centered">
        <div class="badge">Shapes & Finishes</div>
        <h2 class="section-title">Every Shape. Every Finish. Your Vision.</h2>
      </div>
      <div class="shapes-finishes-grid">
        <div class="shapes-col">
          <h3>Popular Shapes</h3>
          <div class="shape-tags">
            <a href="/die-cut-stickers/" class="shape-tag">Die Cut</a>
            <a href="/custom-square-stickers/" class="shape-tag">Square</a>
            <a href="/1-5-inch-round-stickers/" class="shape-tag">Circle</a>
            <a href="/custom-square-stickers/" class="shape-tag">Rectangle</a>
            <span class="shape-tag">Oval</span>
            <a href="/die-cut-stickers/" class="shape-tag">Custom Shape</a>
            <a href="/2-inch-star-stickers/" class="shape-tag">Star</a>
            <span class="shape-tag">Heart</span>
            <span class="shape-tag">Any Shape</span>
          </div>
        </div>
        <div class="shapes-col">
          <h3>Popular Finishes</h3>
          <div class="shape-tags">
            <a href="/glossy-stickers/" class="shape-tag finish">Glossy</a>
            <a href="/matte-stickers/" class="shape-tag finish">Matte</a>
            <a href="/custom-holographic-stickers/" class="shape-tag finish">Holographic</a>
            <a href="/metallic-stickers/" class="shape-tag finish">Metallic</a>
            <span class="shape-tag finish">Soft Touch</span>
            <span class="shape-tag finish">UV Spot</span>
            <a href="/custom-clear-stickers/" class="shape-tag finish">Transparent</a>
            <a href="/embossed-gold-foil-stickers/" class="shape-tag finish">Embossed</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process-section">
    <div class="container">
      <div class="section-header centered">
        <div class="badge">How It Works</div>
        <h2 class="section-title">Order Your Custom Stickers in 4 Easy Steps</h2>
      </div>
      <div class="process-steps">
        {[
          { step: '01', title: 'Choose Your Product', desc: 'Browse our 100+ sticker types and select the perfect product for your needs.', icon: '🔍' },
          { step: '02', title: 'Customize & Configure', desc: 'Select your size, shape, material, finish, and quantity using our easy tool.', icon: '⚙️' },
          { step: '03', title: 'Upload Your Artwork', desc: 'Submit your design file. Our team reviews it for free and confirms before printing.', icon: '🎨' },
          { step: '04', title: 'We Print & Ship', desc: 'Production in 3-5 business days, then fast shipping to your door anywhere in the USA.', icon: '📦' },
        ].map(s => (
          <div class="process-step">
            <div class="step-number">{s.step}</div>
            <div class="step-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="process-cta">
        <a href="/get-a-quote/" class="btn-primary">Start Your Order →</a>
        <a href="/artwork-guidelines/" class="btn-secondary">Artwork Guidelines</a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="why-us">
    <div class="container">
      <div class="why-grid">
        <div class="why-content">
          <div class="badge">Why Choose Us</div>
          <h2 class="section-title">The Custom Stickers Difference</h2>
          <div class="why-items">
            {[
              { icon: '🏆', title: 'Premium Print Quality', desc: 'State-of-the-art digital printing with vibrant CMYK color reproduction and sharp detail.' },
              { icon: '💰', title: 'Wholesale Pricing', desc: 'Competitive bulk pricing with no hidden setup fees. The more you order, the more you save.' },
              { icon: '⚡', title: 'Fast Production', desc: '3-5 business day standard turnaround. Rush options available for urgent orders.' },
              { icon: '🎨', title: 'Free Artwork Review', desc: 'Our design team checks every file before printing to ensure perfect results.' },
              { icon: '🔄', title: 'Satisfaction Guarantee', desc: "Not happy? We'll reprint your order free of charge. Your satisfaction is our priority." },
              { icon: '📞', title: 'Expert Support', desc: 'Real humans available by phone, email, and WhatsApp to help with your order.' },
            ].map(item => (
              <div class="why-item">
                <span class="why-icon">{item.icon}</span>
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="why-visual">
          <div class="why-stats">
            <div class="stat-card">
              <span class="stat-num">100+</span>
              <span class="stat-label">Sticker Products</span>
            </div>
            <div class="stat-card">
              <span class="stat-num">3-5</span>
              <span class="stat-label">Days Production</span>
            </div>
            <div class="stat-card">
              <span class="stat-num">50+</span>
              <span class="stat-label">Min. Order</span>
            </div>
            <div class="stat-card">
              <span class="stat-num">100%</span>
              <span class="stat-label">Satisfaction</span>
            </div>
          </div>
          <img src="/images/custom-sticker-printing/Custom Sticker Printing-1-400.webp" alt="Premium custom sticker printing quality" loading="lazy" decoding="async" width="400" height="320" />
        </div>
      </div>
    </div>
  </section>

  <!-- Product Gallery -->
  <section class="gallery-section">
    <div class="container">
      <div class="section-header centered">
        <div class="badge">Gallery</div>
        <h2 class="section-title">Explore Our Full Sticker Collection</h2>
        <p class="section-subtitle">Browse our complete range of custom sticker products for inspiration.</p>
      </div>
      <div class="gallery-grid">
        {featuredProducts.slice(0, 8).map(p => (
          <a href={`/${p.slug}/`} class="gallery-item">
            <img src={imgThumb(p.images[0])} alt={p.name} loading="lazy" decoding="async" width="280" height="220" />
            <div class="gallery-label">{p.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header centered">
        <div class="badge">FAQ</div>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>
      <div class="faq-grid">
        {[
          { q: 'What types of custom stickers do you offer?', a: 'We offer over 100 sticker types including die cut stickers, vinyl stickers, waterproof stickers, holographic stickers, clear stickers, matte stickers, glossy stickers, bumper stickers, packaging labels, and many more.' },
          { q: 'What is the minimum order quantity?', a: 'Our minimum order is 50 stickers. We offer competitive bulk pricing for orders of 250, 500, 1,000, and above with greater discounts at higher quantities.' },
          { q: 'How long does production take?', a: 'Standard production takes 3-5 business days after artwork approval. Rush production (1-2 business days) is available for an additional fee.' },
          { q: 'What file formats do you accept?', a: 'We accept AI, EPS, PDF, SVG, PNG (300 DPI+), and JPG files. Vector formats (AI, EPS, PDF, SVG) are preferred for the best print quality.' },
          { q: 'Do you offer free proofs?', a: 'Yes! We provide free digital proofs for every order before printing. You approve the proof before we start production.' },
          { q: 'Are your stickers waterproof?', a: 'Our vinyl stickers are waterproof by default. We also offer enhanced waterproof stickers with stronger adhesive and UV coating for demanding outdoor or wet applications.' },
          { q: 'Can I order custom shapes?', a: "Absolutely. Our die cutting technology can cut stickers to virtually any shape. Upload your design and we'll cut it precisely to your artwork outline." },
          { q: 'Do you ship internationally?', a: 'We ship across the United States. Contact us at info@thecustomstickers.co to inquire about international shipping options.' },
        ].map(faq => (
          <div class="faq-item">
            <button class="faq-q">{faq.q} <span class="faq-arrow">+</span></button>
            <div class="faq-a"><p>{faq.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote CTA -->
  <section class="quote-cta-section">
    <div class="container">
      <div class="quote-cta-box">
        <div class="qc-content">
          <h2>Ready to Order Your Custom Stickers?</h2>
          <p>Get a free quote in minutes. Our team is ready to help you create the perfect stickers for your brand.</p>
          <ul class="qc-list">
            <li>✅ Free artwork review &amp; digital proof</li>
            <li>✅ No setup fees</li>
            <li>✅ Wholesale bulk pricing</li>
            <li>✅ Fast 3-5 day production</li>
          </ul>
        </div>
        <div class="qc-actions">
          <a href="/get-a-quote/" class="btn-primary" style="font-size:17px;padding:16px 32px;">Get Free Quote →</a>
          <a href="tel:5033580443" class="btn-secondary">📞 (503) 358-0443</a>
          <a href="mailto:info@thecustomstickers.co" class="btn-secondary">✉️ Email Us</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    padding: 80px 0 100px;
    position: relative;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 50%, rgba(249,115,22,0.15) 0%, transparent 70%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
  }
  .hero .badge { background: rgba(249,115,22,0.2); color: #fb923c; }
  .hero-h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: white;
    margin: 12px 0 20px;
    line-height: 1.15;
  }
  .hero-highlight {
    background: linear-gradient(135deg, #f97316, #fb923c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-desc { color: rgba(255,255,255,0.75); font-size: 1.1rem; line-height: 1.7; margin-bottom: 32px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-trust { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.6); }
  .hero-visual { position: relative; }
  .hero-img-stack { position: relative; }
  .hero-img-main img { border-radius: 20px; box-shadow: 0 30px 80px rgba(0,0,0,0.4); width: 100%; height: auto; object-fit: cover; }
  .hero-img-float { position: absolute; border-radius: 12px; overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,0.3); border: 3px solid rgba(255,255,255,0.1); }
  .float-1 { bottom: -24px; left: -32px; width: 160px; }
  .float-2 { top: 20px; right: -24px; width: 130px; }
  .float-1 img, .float-2 img { width: 100%; height: auto; }
  .hero-badge-float { position: absolute; top: -16px; left: 50%; transform: translateX(-50%); background: var(--primary); color: white; border-radius: 12px; padding: 10px 20px; text-align: center; box-shadow: 0 8px 24px rgba(249,115,22,0.4); }
  .hbf-number { display: block; font-weight: 900; font-size: 1.4rem; line-height: 1; }
  .hbf-text { display: block; font-size: 11px; opacity: 0.85; }
  .trust-bar { background: white; border-bottom: 1px solid var(--gray-200); padding: 24px 0; }
  .trust-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .trust-item { display: flex; align-items: center; gap: 10px; }
  .trust-icon { font-size: 1.5rem; flex-shrink: 0; }
  .trust-item strong { display: block; font-size: 13px; font-weight: 700; color: var(--dark); }
  .trust-item span { font-size: 12px; color: var(--gray-500); }
  .featured-products { padding: 80px 0; background: var(--light-bg); }
  .section-header { margin-bottom: 48px; }
  .section-header.centered { text-align: center; }
  .section-header.centered .section-subtitle { margin: 0 auto; }
  .products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .product-card { display: block; text-decoration: none; }
  .product-img { position: relative; overflow: hidden; height: 200px; }
  .product-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .product-card:hover .product-img img { transform: scale(1.06); }
  .product-overlay { position: absolute; inset: 0; background: rgba(249,115,22,0.85); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; opacity: 0; transition: opacity 0.3s; }
  .product-card:hover .product-overlay { opacity: 1; }
  .product-info { padding: 16px; }
  .product-info h3 { font-size: 15px; margin-bottom: 6px; color: var(--dark); }
  .product-info p { font-size: 13px; color: var(--gray-500); line-height: 1.5; margin-bottom: 10px; }
  .product-cta { font-size: 13px; color: var(--primary); font-weight: 600; }
  .view-all-cta { text-align: center; margin-top: 40px; }
  .for-business { padding: 80px 0; }
  .for-business-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .for-business-content p { margin-bottom: 20px; color: var(--gray-600); font-size: 16px; line-height: 1.7; }
  .for-business-content a { color: var(--accent); text-decoration: underline; }
  .business-list { list-style: none; margin-bottom: 28px; }
  .business-list li { padding: 10px 0; border-bottom: 1px solid var(--gray-100); font-size: 15px; line-height: 1.5; color: var(--gray-700); }
  .business-list a { color: var(--accent); }
  .biz-img-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .biz-img-grid img { border-radius: 12px; width: 100%; height: 140px; object-fit: cover; box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
  .materials-section { padding: 80px 0; background: var(--light-bg); }
