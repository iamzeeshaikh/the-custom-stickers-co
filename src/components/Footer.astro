    <div class="container footer-cta-inner">
      <div class="footer-cta-text">
        <h2>Ready to Print Your Custom Stickers?</h2>
        <p>Get a free quote in minutes. Fast turnaround, premium quality, wholesale pricing.</p>
      </div>
      <div class="footer-cta-actions">
        <a href="/get-a-quote/" class="btn-primary">Get Free Quote</a>
        <a href="tel:5033580443" class="btn-secondary">📞 (503) 358-0443</a>
      </div>
    </div>
  </div>

  <div class="footer-main">
    <div class="container footer-grid">
      <div class="footer-col footer-brand">
        <a href="/" class="footer-logo">
