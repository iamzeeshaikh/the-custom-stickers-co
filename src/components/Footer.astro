      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact Us</a></li>
          <li><a href="/get-a-quote/">Get a Quote</a></li>
          <li><a href="/artwork-guidelines/">Artwork Guidelines</a></li>
