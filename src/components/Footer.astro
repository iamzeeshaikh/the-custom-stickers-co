          <li><a href="/bumper-stickers/">Custom Bumper Stickers</a></li>
          <li><a href="/packaging-labels/">Packaging Labels</a></li>
          <li><a href="/promotional-stickers/">Promotional Stickers</a></li>
          <li><a href="/glossy-stickers/">Glossy Stickers</a></li>
          <li><a href="/matte-stickers/">Matte Stickers</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>More Products</h3>
        <ul>
          <li><a href="/custom-business-stickers/">Business Stickers</a></li>
          <li><a href="/qr-code-stickers/">QR Code Stickers</a></li>
          <li><a href="/custom-labels-and-stickers/">Custom Labels</a></li>
          <li><a href="/metallic-stickers/">Metallic Stickers</a></li>
          <li><a href="/glow-in-the-dark-stickers/">Glow-in-the-Dark Stickers</a></li>
          <li><a href="/reflective-stickers/">Reflective Stickers</a></li>
