---
import { locationStates, stateUrl } from '../data/locations';
const navItems = [
  { label: 'Home', href: '/' },
  {
    label: 'Products', href: '#',
    children: [
      { label: 'Custom Die Cut Stickers', href: '/die-cut-stickers/' },
      { label: 'Custom Vinyl Stickers', href: '/custom-vinyl-stickers/' },
      { label: 'Waterproof Stickers', href: '/waterproof-stickers/' },
      { label: 'Holographic Stickers', href: '/custom-holographic-stickers/' },
      { label: 'Clear Stickers', href: '/custom-clear-stickers/' },
      { label: 'Packaging Labels', href: '/packaging-labels/' },
      { label: 'Promotional Stickers', href: '/promotional-stickers/' },
      { label: 'Bumper Stickers', href: '/bumper-stickers/' },
      { label: 'View All Products →', href: '/stickers-and-labels/' },
    ]
  },
  {
    label: 'Locations', href: '/locations/',
    children: [
      ...locationStates.map((s) => ({ label: `${s.name} Stickers`, href: stateUrl(s) })),
      { label: 'All USA Locations →', href: '/locations/' },
    ]
  },
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="site-header">
  <div class="top-bar">
    <div class="container top-bar-inner">
      <span>📍 Bloomington, IL 61701</span>
      <span><a href="tel:5034614788">(503) 461-4788</a></span>
      <span><a href="mailto:info@thecustomstickers.co">info@thecustomstickers.co</a></span>
    </div>
  </div>
  <nav class="main-nav">
    <div class="container nav-inner">
      <a href="/" class="logo" aria-label="The Custom Stickers Home">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="44" height="44" rx="10" fill="#F97316"/>
          <path d="M22 8L28 16H16L22 8Z" fill="white"/>
          <rect x="14" y="18" width="16" height="12" rx="3" fill="white"/>
          <circle cx="22" cy="34" r="2" fill="white"/>
        </svg>
        <div class="logo-text">
          <span class="logo-name">The Custom Stickers</span>
          <span class="logo-tagline">Premium Sticker Printing</span>
        </div>
      </a>

      <ul class="nav-links" id="nav-links">
        {navItems.map(item => (
          <li class={item.children ? 'has-dropdown' : ''}>
            <a href={item.href}>{item.label} {item.children && <span class="caret">▾</span>}</a>
            {item.children && (
              <ul class="dropdown">
                {item.children.map(child => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <div class="nav-cta">
        <a href="/get-a-quote/" class="btn-primary">Get Free Quote</a>
      </div>

      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .top-bar {
    background: var(--dark);
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    padding: 7px 0;
  }
  .top-bar-inner {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .top-bar a { color: rgba(255,255,255,0.7); transition: color 0.2s; }
  .top-bar a:hover { color: var(--primary); }
  .main-nav {
    background: white;
    border-bottom: 1px solid var(--gray-200);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
  }
  .logo-text { display: flex; flex-direction: column; }
  .logo-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 17px;
    color: var(--dark);
    line-height: 1.2;
  }
  .logo-tagline {
    font-size: 11px;
    color: var(--gray-500);
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    list-style: none;
  }
  .nav-links > li {
    position: relative;
  }
  .nav-links > li > a {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14.5px;
    color: var(--gray-700);
    transition: all 0.2s;
    white-space: nowrap;
  }
  .nav-links > li > a:hover, .nav-links > li > a.active {
    background: var(--gray-100);
    color: var(--primary);
  }
  .caret { font-size: 11px; color: var(--gray-500); }
  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: white;
    border: 1px solid var(--gray-200);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    min-width: 240px;
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.2s ease;
    list-style: none;
    z-index: 100;
  }
  .has-dropdown:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown li a {
    display: block;
    padding: 9px 14px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--gray-700);
    transition: all 0.15s;
  }
  .dropdown li a:hover {
    background: var(--light-bg);
    color: var(--primary);
    padding-left: 18px;
  }
  .nav-cta { flex-shrink: 0; }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    margin-left: auto;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--dark);
    border-radius: 2px;
    transition: all 0.3s;
  }
  @media (max-width: 900px) {
    .nav-links, .nav-cta { display: none; }
    .nav-links.open {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background: white;
      padding: 80px 24px 24px;
      z-index: 999;
      overflow-y: auto;
      gap: 4px;
    }
    .nav-links.open .dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 1px solid var(--gray-200);
      border-radius: 8px;
      margin-top: 4px;
    }
    .nav-toggle { display: flex; z-index: 1001; }
    .top-bar-inner { gap: 12px; justify-content: center; font-size: 12px; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    links?.classList.toggle('open');
  });

  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-links a').forEach(a => {
    if ((a as HTMLAnchorElement).pathname === currentPath) {
      a.classList.add('active');
    }
  });
</script>
