  <button class="whatsapp-fab" id="wa-fab" aria-label="Chat on WhatsApp">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="white">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="wa-pulse"></span>
  </button>
</div>

<style>
  .whatsapp-widget {
    position: fixed;
    bottom: 28px;
    left: 28px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    /* The FAB alone defines the widget box. The popup auto-opens on a 4s timer,
       and while it was in flow that 396px panel resized the widget and
       registered as a layout shift — 0.163 CLS on a slow mobile load. */
    width: 60px;
    height: 60px;
  }
  .whatsapp-fab {
    width: 60px;
    height: 60px;
    background: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    border: none;
    position: relative;
  }
  .whatsapp-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 32px rgba(37, 211, 102, 0.55);
  }
  .wa-pulse {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #25D366;
    opacity: 0.4;
    animation: wa-pulse 2s infinite;
  }
  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.4; }
    70% { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  .whatsapp-popup {
    /* Anchored to the FAB instead of stacked above it in flow, so opening it
       never changes the widget's own box. */
    position: absolute;
    bottom: 72px;
    left: 0;
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.18);
    width: 310px;
    overflow: hidden;
    display: none;
    animation: popIn 0.25s ease;
  }
  .whatsapp-popup.open { display: block; }
  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .wa-popup-header {
    background: #25D366;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .wa-icon {
    width: 44px;
    height: 44px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .wa-header-text { flex: 1; }
  .wa-header-text strong { display: block; color: white; font-size: 15px; }
  .wa-header-text span { color: rgba(255,255,255,0.8); font-size: 12px; }
  .wa-popup-x {
    background: rgba(255,255,255,0.2);
    border: none;
    color: white;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .wa-popup-x:hover { background: rgba(255,255,255,0.3); }
  .wa-popup-body { padding: 20px 16px; }
  .wa-bubble {
    background: #f0f0f0;
    border-radius: 12px 12px 12px 0;
    padding: 12px 14px;
  }
  .wa-bubble p { font-size: 14px; line-height: 1.6; color: var(--dark); }
  .wa-popup-footer { padding: 0 16px 16px; }
  .wa-open-btn {
    display: block;
    background: #25D366;
    color: white;
    text-align: center;
    padding: 13px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 15px;
    transition: background 0.2s;
    text-decoration: none;
  }
  .wa-open-btn:hover { background: #1fba58; }
  .whatsapp-popup-close { display: none; }
  @media (max-width: 400px) {
    .whatsapp-widget { left: 16px; bottom: 20px; }
    .whatsapp-popup { width: calc(100vw - 32px); }
  }
</style>

<script>
  const fab = document.getElementById('wa-fab');
  const popup = document.getElementById('wa-popup');
  const closeBtn = document.getElementById('wa-popup-close');

  fab?.addEventListener('click', () => {
    popup?.classList.toggle('open');
  });
  closeBtn?.addEventListener('click', () => {
    popup?.classList.remove('open');
  });

  setTimeout(() => {
    popup?.classList.add('open');
  }, 4000);
</script>
